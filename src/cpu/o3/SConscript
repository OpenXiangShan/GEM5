# Unit tests for trace reader (ChampSim)
# Keep this outside the ISA guard so it can build under NULL for unittests
if env['CONF']['TARGET_ISA'] == 'null':
    # Generate required debug flag headers for reader in NULL builds
    DebugFlag('TraceReader')
    env.Append(LIBS=['z'])
    # Targeted regression tests for 3 trace-mode failure modes
    # (commits 064029e6ef, add587d180, 803b6ec090). No gem5 link deps.
    GTest('trace_mode_regression.test',
          'trace/trace_mode_regression.test.cc')
    # L0 anchored tests for the commit-side metadata cleanup guard
    # (guards commit e87d6b5db4). Header-only anchor, no gem5 link deps.
    GTest('trace_meta_guard.test',
          'trace/trace_meta_guard.test.cc')
    # L0 anchored tests for the CBP2025 register mapping table (guards the
    # x5 fix-of-fix chain 89b00fb712 -> a28e34a2cc -> 9d97cbb232).
    GTest('cbp_reg_map.test',
          'trace/cbp_reg_map.test.cc')
    # L0 anchored tests for the trace branch-truth override rule (guards
    # the b5fefebcef port-gap completing 23b02c3f0d's partial port of
    # c7be4bd32a).
    GTest('branch_classification.test',
          'trace/branch_classification.test.cc')

    # L2 anchored recovery-plan tests (guards commits 090d525ed3 and
    # 1d9e0ef5b0). Header-only anchor, no gem5 link deps.
    GTest('trace_recovery.test',
          'trace/trace_recovery.test.cc')
    # Anchored address-mapping tests (TraceReader statics; guards commits
    # 6adcc80da4, b811be1b87, a7da33710e, 06a611df32, 7a01b49499).
    # Links the same reader/stats infra as the reader test below.
    GTest('trace_addr_map.test',
          'trace/trace_addr_map.test.cc',
          'trace/TraceReader.cc',
          'trace/ChampSimTraceReader.cc',
          'trace/CBP2025TraceReader.cc',
          '../../base/stats/group.cc',
          '../../base/stats/info.cc',
          '../../base/stats/storage.cc',
          '../../base/statistics.cc',
          with_tag('gem5 trace'),
          '../../sim/root.cc',
          '../../base/time.cc',
          '../../base/hostinfo.cc',
          '../../base/output.cc',
          '../../sim/core.cc',
          '../../sim/sim_object.cc',
          '../../sim/globals.cc',
          '../../sim/tags.cc')
    GTest('champsim_trace_reader.test',
          'trace/ChampSimTraceReader.test.cc',
          'trace/TraceReader.cc',
          'trace/ChampSimTraceReader.cc',
          'trace/CBP2025TraceReader.cc',
          # pull in stats primitives used by TraceReader::TraceReaderStats
          '../../base/stats/group.cc',
          '../../base/stats/info.cc',
          '../../base/stats/storage.cc',
          '../../base/statistics.cc',
          # bring in tracing/logger and helpers (this also provides
          # cur_tick.cc, which carries the 'gem5 trace' tag — do NOT list it
          # explicitly as well, or the object appears twice on the link
          # line and _curTickPtr gets multiply defined)
          with_tag('gem5 trace'),
          # Stats Root for tests
          '../../sim/root.cc',
          # Root pulls in the SimObject/Globals/time infrastructure; without
          # these objects the NULL-variant link fails with undefined
          # references to gem5::SimObject::*, vtable for gem5::Globals,
          # gem5::memUsage() and gem5::Time (mirrors the real-ISA branch
          # below, which already lists exactly these sources).
          '../../base/time.cc',
          '../../base/hostinfo.cc',
          '../../base/output.cc',
          '../../sim/core.cc',
          '../../sim/sim_object.cc',
          '../../sim/globals.cc',
          '../../sim/tags.cc')
else:
    # Under real ISAs, link against common trace infra and avoid duplicate
    # compilation of cur_tick and stats glue (already provided by libs).
    env.Append(LIBS=['z'])
    # Targeted regression tests for 3 trace-mode failure modes
    # (commits 064029e6ef, add587d180, 803b6ec090). No gem5 link deps.
    GTest('trace_mode_regression.test',
          'trace/trace_mode_regression.test.cc')
    # L0 anchored tests for the commit-side metadata cleanup guard
    # (guards commit e87d6b5db4). Header-only anchor, no gem5 link deps.
    GTest('trace_meta_guard.test',
          'trace/trace_meta_guard.test.cc')
    # L0 anchored tests for the CBP2025 register mapping table (guards the
    # x5 fix-of-fix chain 89b00fb712 -> a28e34a2cc -> 9d97cbb232).
    GTest('cbp_reg_map.test',
          'trace/cbp_reg_map.test.cc')
    # L0 anchored tests for the trace branch-truth override rule (guards
    # the b5fefebcef port-gap completing 23b02c3f0d's partial port of
    # c7be4bd32a).
    GTest('branch_classification.test',
          'trace/branch_classification.test.cc')
    # L2 anchored recovery-plan tests (guards commits 090d525ed3 and
    # 1d9e0ef5b0). Header-only anchor, no gem5 link deps.
    GTest('trace_recovery.test',
          'trace/trace_recovery.test.cc')
    # Anchored address-mapping tests (TraceReader statics; guards commits
    # 6adcc80da4, b811be1b87, a7da33710e, 06a611df32, 7a01b49499).
    GTest('trace_addr_map.test',
          'trace/trace_addr_map.test.cc',
          'trace/TraceReader.cc',
          'trace/ChampSimTraceReader.cc',
          'trace/CBP2025TraceReader.cc',
          '../../base/stats/group.cc',
          '../../base/stats/info.cc',
          '../../base/stats/storage.cc',
          '../../base/statistics.cc',
          '../../base/time.cc',
          '../../base/hostinfo.cc',
          '../../base/output.cc',
          '../../sim/core.cc',
          '../../sim/sim_object.cc',
          '../../sim/globals.cc',
          '../../sim/tags.cc',
          '../../sim/root.cc',
          with_tag('gem5 trace'))
    GTest('champsim_trace_reader.test',
          'trace/ChampSimTraceReader.test.cc',
          'trace/TraceReader.cc',
          'trace/ChampSimTraceReader.cc',
          'trace/CBP2025TraceReader.cc',
          # pull in stats primitives (some environments require explicit objs)
          '../../base/stats/group.cc',
          '../../base/stats/info.cc',
          '../../base/stats/storage.cc',
          '../../base/statistics.cc',
          # Root depends on the core SimObject/time infrastructure when we
          # link an ISA-enabled variant, so add the minimal objects that
          # provide those symbols explicitly.
          '../../base/time.cc',
          '../../base/hostinfo.cc',
          '../../base/output.cc',
          '../../sim/core.cc',
          '../../sim/sim_object.cc',
          '../../sim/globals.cc',
          '../../sim/tags.cc',
          # Stats Root is required when constructing statistics::Group in tests
          '../../sim/root.cc',
          with_tag('gem5 trace'))
