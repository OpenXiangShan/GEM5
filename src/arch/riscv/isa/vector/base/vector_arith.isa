}};

def format VectorCompressFormat(code, category, *flags) {{
    iop = InstObjParams(name, Name, "VCompressMacroInst",
                        {'vd_multiplier': '1.0',
                         'vs1_multiplier': '0',
                         'vs2_multiplier': '1.0'},
                        flags)

    decode_block = VectorIntDecodeBlock.subst(iop)
}};
