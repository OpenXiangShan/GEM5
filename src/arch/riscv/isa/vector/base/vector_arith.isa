let {{
    def vecSubRegId(base, arch_div=1):
        """Convert _microIdx + base to sub-register index.
        arch_div: divisor for the arch-level vreg offset
          (e.g., 2 for narrowing dest or widening source where
           arch_div consecutive microIdx share 1 arch vreg sub-bank)
        """
        if arch_div == 1:
            return "RegId(VecRegClass, (%s + _microIdx / VregBanks) * VregBanks + (_microIdx %% VregBanks))" % base
        else:
            return (
                "RegId(VecRegClass, "
                "(%s + _microIdx / (%d * VregBanks)) * VregBanks + "
                "((_microIdx / %d) %% VregBanks))"
            ) % (base, arch_div, arch_div)

    def vecNarrowDestRegId(base="_machInst.vd"):
        """Narrowing dest/old-dest share one arch register per two micro-ops."""
        return vecSubRegId(base, 2)

    def vecNarrowSrcRegId(base="_machInst.vs2"):
        """Narrowing source uses pair-shared bank mapping for tiny LMUL."""
        return """RegId(VecRegClass,
            (%s + ((vtype_vlmul(_machInst.vtype8) < -1) ?
                (_microIdx / (2 * VregBanks)) : (_microIdx / VregBanks))) *
            VregBanks +
            (((vtype_vlmul(_machInst.vtype8) < -1) ?
                (_microIdx / 2) : _microIdx) %% VregBanks))""" % base

    def vecWidenDestRegId(base="_machInst.vd"):
        """Widening destination keeps one bank per micro-op."""
        return vecSubRegId(base)

    def vecWidenNarrowSrcRegId(base):
        """Widening source or narrow-width source that shares one arch reg per pair."""
        return vecSubRegId(base, 2)

    def vecWidenSrc2RegId(inst_suffix, base="_machInst.vs2"):
        """Map widening src2 based on suffix family."""
        if inst_suffix in ["vv", "vx", "vf", "vi"]:
            return vecWidenNarrowSrcRegId(base)
        if inst_suffix in ["wv", "wx", "wf"]:
            return vecSubRegId(base)
        error("unsupported widening suffix: %s" % inst_suffix)

    def vecReduceWidenSrcRegId(base="_machInst.vs2"):
        """Widen-reduce src2 uses pair-shared bank mapping on fractional LMUL."""
        return """RegId(VecRegClass,
            (%s + ((vtype_vlmul(_machInst.vtype8) < 0) ?
                (_microIdx / (2 * VregBanks)) : (_microIdx / VregBanks))) *
            VregBanks +
            (((vtype_vlmul(_machInst.vtype8) < 0) ?
                (_microIdx / 2) : _microIdx) %% VregBanks))""" % base

    def vecReduceSrcRegId(base="_machInst.vs2"):
        """Reduce src2 keeps fractional LMUL slices in lower banks."""
        return """RegId(VecRegClass,
            (%s + ((vtype_vlmul(_machInst.vtype8) < 0) ?
                (_microIdx / ((1u << (-vtype_vlmul(_machInst.vtype8))) * VregBanks))
                : (_microIdx / VregBanks))) * VregBanks +
            (((vtype_vlmul(_machInst.vtype8) < 0) ?
                (_microIdx / (1u << (-vtype_vlmul(_machInst.vtype8))))
                : _microIdx) %% VregBanks))""" % base

    def vecMaskOldDestRegId(base="_machInst.vd"):
        return "RegId(VecRegClass, %s * VregBanks)" % base

    def setDestWrapper(destRegId):
        return "setDestRegIdx(_numDestRegs++, " + destRegId + ");\n" + \
               "_numTypedDestRegs[VecRegClass]++;\n"
    def setSrcWrapper(srcRegId):
        return "setSrcRegIdx(_numSrcRegs++, " + srcRegId + ");\n"
    def setOldDestWrapper(destRegId):
        return """
        oldDstIdx = _numSrcRegs;
        setSrcRegIdx(_numSrcRegs++, %s);
        """ % destRegId
    def setSrcVL():
        return 'SET_VL_SRC();'
    def setSrcVType():
        return 'SET_VTYPE_SRC();'
    def setSrcVm():
        return """
        SET_VM_SRC();
        """
    def vmDeclAndReadData():
        return '''
        VM_REQUIRED();
        '''
    def copyOldVd(vd_idx):
        return ''
    def loopWrapper(code, micro_inst = True):
        if micro_inst:
            upper_bound = "elem_num_per_vreg"
        else:
            upper_bound = "rVl"
        return '''
            for (uint32_t i = 0; i < %s; i++) {
                %s
            }
        ''' % (upper_bound, code)
    def loopWrapperWithVMI(code):
        return '''
            for (uint32_t elem_idx = vmi.rs; elem_idx < vmi.re; elem_idx++) {
                uint32_t i = elem_idx - vmi.rs;
                %s
            }
        ''' % (code)
    def maskCondWrapper(code, withvm = True):
        if withvm:
            return """
            if ((ei < rVl) && (this->vm || elem_mask(v0, ei))) {
                %s
            }
            """ % (code)
        else:
            return """
            if (ei < rVl) {
                %s
            }
            """ % (code)

    def eiDeclarePrefix(code, widening = False):
        if widening:
            return '''
            uint32_t ei = i + micro_vlmax * this->microIdx;
            ''' + code
        else:
            return '''
            uint32_t ei = i + elem_num_per_vreg * this->microIdx;
            ''' + code

    def eiDeclarePrefixWithVMI(code, widening = False):
        if widening:
            return '''
            uint32_t ei = i + micro_vlmax * this->microIdx;
            ''' + code
        else:
            return '''
            uint32_t ei = elem_idx;
            ''' + code

    def wideningOpRegisterConstraintChecks(code):
        return code
        return '''
            const uint32_t num_microops = 1 << std::max<int64_t>(0, vtype_vlmul(machInst.vtype8) + 1);
            if ((machInst.vd % alignToPowerOfTwo(num_microops)) != 0) {
                std::string error =
                    csprintf("Unaligned Vd group in Widening op");
                return std::make_shared<IllegalInstFault>(error, machInst);
            }
            if ((machInst.vs2 <= machInst.vd) && (machInst.vd < (machInst.vs2 + num_microops - 1))) {
                // A destination vector register group can overlap a source vector
                // register group if The destination EEW is greater than the source
                // EEW, the source EMUL is at least 1, and the overlap is in the
                // highest- numbered part of the destination register group.
                std::string error =
                    csprintf("Unsupported overlap in Vs2 and Vd for Widening op");
                return std::make_shared<IllegalInstFault>(error, machInst);
            }
            ''' + code

    def narrowingOpRegisterConstraintChecks(code):
        return '''
            const uint32_t num_microops = 1 << std::max<int64_t>(0, vtype_vlmul(machInst.vtype8) + 1);
            if ((machInst.vs2 % alignToPowerOfTwo(num_microops)) != 0) {
                std::string error =
                    csprintf("Unaligned VS2 group in Narrowing op");
                return std::make_shared<IllegalInstFault>(error, machInst);
            }
            if ((machInst.vs2 < machInst.vd) && (machInst.vd <= (machInst.vs2 + num_microops - 1))) {
                // A destination vector register group can overlap a source vector
                // register group The destination EEW is smaller than the source EEW
                // and the overlap is in the lowest-numbered part of the source
                // register group
                std::string error =
                    csprintf("Unsupported overlap in Vs2 and Vd for Narrowing op");
                return std::make_shared<IllegalInstFault>(error, machInst);
            }
        ''' + code

    def fflags_wrapper(code):
        return '''
        RegVal FFLAGS = xc->readMiscReg(MISCREG_FFLAGS);
        feclearexcept(FE_ALL_EXCEPT);
        ''' + code + '''
        FFLAGS |= softfloat_exceptionFlags;
        if (softfloat_exceptionFlags) {
            softfloat_exceptionFlags = 0;
            xc->setMiscReg(MISCREG_FFLAGS, FFLAGS);
        }
        '''
}};


def format VectorIntFormat(code, category, *flags) {{
    macroop_class_name = 'VectorArithMacroInst'
    microop_class_name = 'VectorArithMicroInst'
    is_vxunary0 = False

    # VXUNARY0 instructions use vs1 as function encoding, not as source register
    if name in ["vid_v", "vclz_v", "vctz_v", "vcpop_v", "vbrev_v", "vbrev8_v", "vrev8_v"] :
        macroop_class_name = 'VectorVMUNARY0MacroInst'
        microop_class_name = 'VectorVMUNARY0MicroInst'
        is_vxunary0 = True

    vs1_mul = '1.0' if (category in ["OPIVV", "OPMVV"] and not is_vxunary0) else '0'
    iop = InstObjParams(name, Name, macroop_class_name,
                        {'code': code,
                         'vd_multiplier': '1.0',
                         'vs1_multiplier': vs1_mul,
                         'vs2_multiplier': '1.0'},
                        flags)
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    v0_required = inst_name not in ["vmv"]
    mask_cond = v0_required and (inst_suffix not in ['vvm', 'vxm', 'vim'])
    need_elem_idx = mask_cond or code.find("ei") != -1

    dest_reg_id = "RegId(VecRegClass, vmi.microVd)"

    num_src_regs = 0

    src2_reg_id = "RegId(VecRegClass, vmi.microVs2)"
    num_src_regs += 1

    src1_reg_id = ""
    if category in ["OPIVV", "OPMVV"] and not is_vxunary0:
        src1_reg_id = "RegId(VecRegClass, vmi.microVs1)"
        num_src_regs += 1
    elif category in ["OPIVX", "OPMVX"]:
        src1_reg_id = "RegId(IntRegClass, _machInst.rs1)"
        num_src_regs += 1
    elif category == "OPIVI" or is_vxunary0:
        pass
    else:
        error("not supported category for VectorIntFormat: %s" % category)

    old_vd_idx = num_src_regs

    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    if category != "OPIVI" and not is_vxunary0:
        set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    if v0_required:
        set_src_reg_idx += setSrcVm()
    set_src_reg_idx += setSrcVType()

    # code
    code = maskCondWrapper(code, mask_cond)
    code = eiDeclarePrefixWithVMI(code)
    code = loopWrapperWithVMI(code)

    vm_decl_rd = ""
    if v0_required:
        vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        microop_class_name,
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx)},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorIntMicroDeclareWithVMI.subst(microiop) + \
        VectorIntMicroConstructorWithVMI.subst(microiop) + \
        VectorIntMicroExecute.subst(microiop) + \
        VectorIntMacroDeclare.subst(iop) + \
        VectorIntMacroConstructorWithVMI.subst(iop)

    decode_block = VectorIntDecodeBlock.subst(iop)
}};


def format VectorIntExtFormat(code, category, *flags) {{
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    ext_div = int(inst_suffix[-1])
    vs2_mul = str(1.0/ext_div)
    iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                        {'code': code,
                         'vd_multiplier': '1.0',
                         'vs1_multiplier': '0',
                         'vs2_multiplier': vs2_mul},
                        flags)

    old_vd_idx = 1
    # For widening with tiny fractional LMUL (mf8/mf4), two micros still come
    # from one source bank but destination should stay in one physical bank.
    # Keep original mapping for vlmul >= -1, collapse pair-to-same-bank for < -1.
    dest_reg_id = """RegId(VecRegClass,
        (_machInst.vd + ((vtype_vlmul(_machInst.vtype8) < -1) ?
            (_microIdx / (2 * VregBanks)) : (_microIdx / VregBanks))) *
        VregBanks +
        (((vtype_vlmul(_machInst.vtype8) < -1) ?
            (_microIdx / 2) : _microIdx) % VregBanks))"""
    src2_reg_id = vecSubRegId("_machInst.vs2", ext_div)

    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    set_src_reg_idx += setSrcVm()
    set_src_reg_idx += setSrcVType()

    code = maskCondWrapper(code)
    code = eiDeclarePrefix(code)
    code = loopWrapper(code)
    vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx),
         'ext_div': ext_div},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    # Note: VectorIntExtMacroConstructor needs ext_div parameter from microiop
    ext_iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                           {'code': code, 'ext_div': ext_div}, flags)
    header_output = \
        VectorIntExtMicroDeclare.subst(microiop) + \
        VectorIntMicroConstructor.subst(microiop) + \
        VectorIntExtMicroExecute.subst(microiop) + \
        VectorIntExtMacroDeclare.subst(iop) + \
        VectorIntExtMacroConstructor.subst(ext_iop)

    decode_block = VectorIntDecodeBlock.subst(iop)
}};

def format VectorIntWideningFormat(code, category, *flags) {{
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    vs2_mul = '2.0' if inst_suffix in ["wv", "wx"] else '1.0'
    vs1_mul = '1.0' if inst_suffix in ["vv", "wv"] else '0'
    iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                        {'code': code,
                         'vd_multiplier': '2.0',
                         'vs1_multiplier': vs1_mul,
                         'vs2_multiplier': vs2_mul},
                        flags)
    v0_required = True
    mask_cond = v0_required
    need_elem_idx = mask_cond or code.find("ei") != -1
    old_vd_idx = 2
    dest_reg_id = vecWidenDestRegId("_machInst.vd")
    src1_reg_id = ""
    if category in ["OPIVV", "OPMVV"]:
        src1_reg_id = vecWidenNarrowSrcRegId("_machInst.vs1")
    elif category in ["OPIVX", "OPMVX"]:
        src1_reg_id = "RegId(IntRegClass, _machInst.rs1)"
    elif category == "OPIVI":
        old_vd_idx = 1
    else:
        error("not supported category for VectorIntFormat: %s" % category)
    src2_reg_id = vecWidenSrc2RegId(inst_suffix, "_machInst.vs2")

    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    if category != "OPIVI":
        set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    if v0_required:
        set_src_reg_idx += setSrcVm()

    # code
    code = maskCondWrapper(code, mask_cond)
    code = eiDeclarePrefix(code, widening=True)
    code = loopWrapper(code)

    code = wideningOpRegisterConstraintChecks(code)

    vm_decl_rd = ""
    if v0_required:
        vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx)},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorIntWideningMicroDeclare.subst(microiop) + \
        VectorIntWideningMicroConstructor.subst(microiop) + \
        VectorIntWideningMicroExecute.subst(microiop) + \
        VectorIntWideningMacroDeclare.subst(iop) + \
        VectorIntWideningMacroConstructor.subst(iop)

    decode_block = VectorIntWideningDecodeBlock.subst(iop)
}};

def format VectorIntNarrowingFormat(code, category, *flags) {{
    vs1_mul = '1.0' if category in ["OPIVV"] else '0'
    iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                        {'code': code,
                         'vd_multiplier': '1.0',
                         'vs1_multiplier': vs1_mul,
                         'vs2_multiplier': '2.0'},
                        flags)
    mask_cond = True
    need_elem_idx = True

    old_vd_idx = 2
    dest_reg_id = vecNarrowDestRegId("_machInst.vd")
    if category in ["OPIVV"]:
        src1_reg_id = vecNarrowDestRegId("_machInst.vs1")
    elif category in ["OPIVX"]:
        src1_reg_id = "RegId(IntRegClass, _machInst.rs1)"
    elif category == "OPIVI":
        old_vd_idx = 1
    else:
        error("not supported category for VectorIntFormat: %s" % category)
    src2_reg_id = vecNarrowSrcRegId("_machInst.vs2")
    old_dest_reg_id = vecNarrowDestRegId("_machInst.vd")

    set_dest_reg_idx = setDestWrapper(dest_reg_id)
    set_src_reg_idx = ""
    if category != "OPIVI":
        set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(old_dest_reg_id)
    set_src_reg_idx += setSrcVL()
    set_src_reg_idx += setSrcVm()
    # code
    code = maskCondWrapper(code)
    code = eiDeclarePrefix(code, widening=True)
    code = loopWrapper(code)
    code = narrowingOpRegisterConstraintChecks(code)
    vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx),
         },
        flags)

# Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorIntNarrowingMicroDeclare.subst(microiop) + \
        VectorIntNarrowingMicroConstructor.subst(microiop) + \
        VectorIntNarrowingMicroExecute.subst(microiop) + \
        VectorIntNarrowingMacroDeclare.subst(iop) + \
        VectorIntNarrowingMacroConstructor.subst(iop)

    decode_block = VectorIntNarrowingDecodeBlock.subst(iop)
}};

def format VectorIntMaskFormat(code, category, *flags) {{
    vs1_mul = '1.0' if category in ["OPIVV"] else '0'
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    v0_required = not (inst_name in ["vmadc", "vmsbc"] \
        and inst_suffix in ["vv", "vx", "vi"])
    mask_cond = inst_name not in ['vmadc', 'vmsbc']
    iop = InstObjParams(name,
        Name,
        'VectorArithMacroInst',
        {'code': code,
         'mask_cond': 'true' if mask_cond else 'false',
         'vd_multiplier': '0',
         'vs1_multiplier': vs1_mul,
         'vs2_multiplier': '1.0'},
        flags)
    need_elem_idx = mask_cond or code.find("ei") != -1

    old_vd_idx = 2
    src1_reg_id = ""
    if category == "OPIVV":
        src1_reg_id = vecSubRegId("_machInst.vs1")
    elif category == "OPIVX":
        src1_reg_id = "RegId(IntRegClass, _machInst.rs1)"
    elif category == "OPIVI":
        old_vd_idx = 1
    else:
        error("not supported category for VectorIntFormat: %s" % category)
    src2_reg_id = vecSubRegId("_machInst.vs2")
    set_dest_reg_idx = """
        RegId dst_reg(VecBufRegClass, _packedSlot);
        dst_reg.setNumPinnedWrites(_expectedWrites > 0 ? _expectedWrites - 1 : 0);
        setDestRegIdx(_numDestRegs++, dst_reg);
        _numTypedDestRegs[VecBufRegClass]++;
    """
    set_src_reg_idx = ""
    if category != "OPIVI":
        set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setSrcVL()
    if v0_required:
        set_src_reg_idx += setSrcVm()

    #code
    code = maskCondWrapper(code, mask_cond)
    code = eiDeclarePrefix(code)
    code = loopWrapper(code)

    vm_decl_rd = ""
    if v0_required:
        vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx)},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorIntMaskMicroDeclare.subst(microiop) + \
        VectorIntMaskMicroConstructor.subst(microiop) + \
        VectorIntMaskMicroExecute.subst(microiop) + \
        VectorIntMaskMacroDeclare.subst(iop) + \
        VectorIntMaskMacroConstructor.subst(iop)
    decode_block = VectorIntDecodeBlock.subst(iop)
}};

def format VectorGatherFormat(code, category, *flags) {{
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    if inst_name == "vrgatherei16":
        idx_type = "uint16_t"
    else:
        idx_type = "elem_type"
    if category in ["OPIVV"]:
        # vrgatherei16.vv: EMUL(vs1) = (16/SEW) * LMUL, so check must be sew-aware.
        if inst_name == "vrgatherei16":
            vs1_mul = ("(machInst.vtype8.vsew == 0b000 ? 2.0 : "
                       " machInst.vtype8.vsew == 0b001 ? 1.0 : "
                       " machInst.vtype8.vsew == 0b010 ? 0.5 : "
                       " machInst.vtype8.vsew == 0b011 ? 0.25 : 0.0)")
        else:
            vs1_mul = '1.0'
    else:
        vs1_mul = '0'
    iop = InstObjParams(name, Name, 'VectorGatherMacroInst',
        {'idx_type': idx_type,
         'code': code,
         'vd_multiplier': '1.0',
         'vs1_multiplier': vs1_mul,
         'vs2_multiplier': '1.0'},
        flags)
    old_vd_idx = 2
    dest_reg_id = "RegId(VecRegClass, (_machInst.vd + vd_idx) * VregBanks + vd_bank)"
    src1_reg_id = ""
    if category in ["OPIVV"]:
        src1_reg_id = "RegId(VecRegClass, (_machInst.vs1 + vs1_idx) * VregBanks + vs1_bank)"
    elif category in ["OPIVX"]:
        src1_reg_id = "RegId(IntRegClass, _machInst.rs1)"
    elif category == "OPIVI":
        old_vd_idx = 1
    else:
        error("not supported category for VectorIntFormat: %s" % category)
    # Note: src2_reg_id is not used in the new VectorGatherMicroConstructor
    # because we manually set all source registers there
    src2_reg_id = "RegId(VecRegClass, _machInst.vs2)"

    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    if category != "OPIVI":
        set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    set_src_reg_idx += setSrcVm()

    # code

    vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx),
         'idx_type': idx_type},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorGatherMicroDeclare.subst(microiop) + \
        VectorGatherMicroConstructor.subst(microiop) + \
        VectorGatherMicroExecute.subst(microiop) + \
        VectorGatherMacroDeclare.subst(iop) + \
        VectorGatherMacroConstructor.subst(iop)

    decode_block = VectorGatherDecodeBlock.subst(iop)

}};

def format VectorFloatFormat(code, category, *flags) {{
    vs1_mul = '1.0' if category in ["OPFVV"] else '0'
    iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                        {'code': code,
                         'vd_multiplier': '1.0',
                         'vs1_multiplier': vs1_mul,
                         'vs2_multiplier': '1.0'},
                        flags)
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    v0_required = inst_name not in ["vfmv"]
    mask_cond = v0_required and (inst_suffix not in ['vvm', 'vfm'])
    need_elem_idx = mask_cond or code.find("ei") != -1

    dest_reg_id = "RegId(VecRegClass, vmi.microVd)"
    src1_reg_id = ""
    if category == "OPFVV":
        src1_reg_id = "RegId(VecRegClass, vmi.microVs1)"
    elif category == "OPFVF":
        src1_reg_id = "RegId(FloatRegClass, _machInst.rs1)"
    else:
        error("not supported category for VectorFloatFormat: %s" % category)
    src2_reg_id = "RegId(VecRegClass, vmi.microVs2)"

    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    if v0_required:
        set_src_reg_idx += setSrcVm()
    # code
    code = maskCondWrapper(code, mask_cond)
    code = eiDeclarePrefixWithVMI(code)
    code = loopWrapperWithVMI(code)
    code = fflags_wrapper(code)

    vm_decl_rd = ""
    if v0_required:
        vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(2)},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorFloatMicroDeclareWithVMI.subst(microiop) + \
        VectorFloatMicroConstructorWithVMI.subst(microiop) + \
        VectorFloatMicroExecute.subst(microiop) + \
        VectorFloatMacroDeclare.subst(iop) + \
        VectorFloatMacroConstructorWithVMI.subst(iop)

    decode_block = VectorFloatDecodeBlock.subst(iop)
}};

def format VectorFloatCvtFormat(code, category, *flags) {{
    iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                        {'code': code,
                         'vd_multiplier': '1.0',
                         'vs1_multiplier': '0',
                         'vs2_multiplier': '1.0'},
                        flags)

    old_vd_idx = 1
    dest_reg_id = vecWidenDestRegId("_machInst.vd")
    src2_reg_id = vecNarrowSrcRegId("_machInst.vs2")

    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    set_src_reg_idx += setSrcVm()
    code = maskCondWrapper(code)
    code = eiDeclarePrefix(code)
    code = loopWrapper(code)
    code = fflags_wrapper(code)

    vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(old_vd_idx)},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorFloatCvtMicroDeclare.subst(microiop) + \
        VectorFloatMicroConstructor.subst(microiop) + \
        VectorFloatMicroExecute.subst(microiop) + \
        VectorFloatCvtMacroDeclare.subst(iop) + \
        VectorFloatMacroConstructor.subst(iop)

    decode_block = VectorFloatDecodeBlock.subst(iop)
}};

def format VectorFloatWideningFormat(code, category, *flags) {{
    inst_name, inst_suffix = name.split("_", maxsplit=1)
    vs2_mul = '2.0' if inst_suffix in ["wv", "wf"] else '1.0'
    vs1_mul = '1.0' if inst_suffix in ["vv", "wv"] else '0'
    iop = InstObjParams(name, Name, 'VectorArithMacroInst',
                        {'code': code,
                         'vd_multiplier': '2.0',
                         'vs1_multiplier': vs1_mul,
                         'vs2_multiplier': vs2_mul},
                        flags)
    v0_required = True
    mask_cond = v0_required
    need_elem_idx = mask_cond or code.find("ei") != -1

    dest_reg_id = vecSubRegId("_machInst.vd")
    src1_reg_id = ""
    if category in ["OPFVV"]:
        src1_reg_id = vecWidenNarrowSrcRegId("_machInst.vs1")
    elif category in ["OPFVF"]:
        src1_reg_id = "RegId(FloatRegClass, _machInst.rs1)"
    else:
        error("not supported category for VectorFloatFormat: %s" % category)
    src2_reg_id = vecWidenSrc2RegId(inst_suffix, "_machInst.vs2")
    set_dest_reg_idx = setDestWrapper(dest_reg_id)

    set_src_reg_idx = ""
    set_src_reg_idx += setSrcWrapper(src1_reg_id)
    set_src_reg_idx += setSrcWrapper(src2_reg_id)
    set_src_reg_idx += setOldDestWrapper(dest_reg_id)
    set_src_reg_idx += setSrcVL()
    if v0_required:
        set_src_reg_idx += setSrcVm()

    # code
    code = maskCondWrapper(code, mask_cond)
    code = eiDeclarePrefix(code, widening=True)
    code = loopWrapper(code)
    code = fflags_wrapper(code)

    code = wideningOpRegisterConstraintChecks(code)

    vm_decl_rd = ""
    if v0_required:
        vm_decl_rd = vmDeclAndReadData()

    microiop = InstObjParams(name + "_micro",
        Name + "Micro",
        'VectorArithMicroInst',
        {'code': code,
         'set_dest_reg_idx': set_dest_reg_idx,
         'set_src_reg_idx': set_src_reg_idx,
         'vm_decl_rd': vm_decl_rd,
         'copy_old_vd': copyOldVd(2)},
        flags)

    # Because of the use of templates, we had to put all parts in header to
    # keep the compiler happy.
    header_output = \
        VectorIntWideningMicroDeclare.subst(microiop) + \
        VectorIntWideningMicroConstructor.subst(microiop) + \
        VectorFloatWideningMicroExecute.subst(microiop) + \
        VectorIntWideningMacroDeclare.subst(iop) + \
        VectorIntWideningMacroConstructor.subst(iop)

    decode_block = VectorFloatWideningDecodeBlock.subst(iop)
}};

