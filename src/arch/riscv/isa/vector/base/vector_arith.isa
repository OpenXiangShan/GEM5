    (header_output, decode_block) = VectorSlideBase(name, Name, category, code,
        flags,
        macro_construtor = VectorSlideDownMacroConstructor,
        decode_template = VectorIntDecodeBlock,
        micro_execute_template = VectorSlideMicroExecute)
}};

