def template VlmConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    const int32_t nf = _machInst.nf + 1;
    eew = 8;
    _machInst.width = 0;
    const uint32_t elem_num_per_bank = DPLEN / eew;
    const uint32_t vreg_banks = VLEN / DPLEN;
    // panic_if(nf * emul > 8, "invalid nf and emul");

    VectorMicroInfo vmi;
    if (nf == 1) {
        const uint32_t active_mask_banks = calculateActiveMaskMemBanks(sew, vflmul);
        for (uint32_t i = 0; i < active_mask_banks; i++) {
            StaticInstPtr microop;
            vmi.rs = i * elem_num_per_bank;
            vmi.re = (i + 1) * elem_num_per_bank;
            vmi.microVd = i;
            vmi.offset = i * DPLENB;
            microop = new Vlm_vMicro(_machInst, i, vmi);
            microop->setDelayedCommit();
            microop->setFlag(IsLoad);
            microop->setNF(nf);
            this->microops.push_back(microop);

            VectorMicroInfo merge_vmi;
            merge_vmi.rs = i * DPLEN;
            merge_vmi.re = (i + 1) * DPLEN;
            merge_vmi.fn = 0;
            merge_vmi.microVd = VD * VregBanks + i;
            microop = new BitMaskMergeMicroInst(
                _machInst, merge_vmi, i, false, false, true);
            microop->setDelayedCommit();
            microop->setNF(nf);
            this->microops.push_back(microop);
        }
    } else {
        // TODO
        panic("not implemented");
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VssegMicroInitiateAcc {{

#if %(is_vecIndex)s

template<typename ElemType>
Fault
%(class_name)s<ElemType>::initiateAcc(ExecContext* xc,
                            Trace::InstRecord* traceData) const

#else

Fault
%(class_name)s::initiateAcc(ExecContext* xc,
                            Trace::InstRecord* traceData) const

#endif
{
#if %(is_vecIndex)s
    using vu = std::make_unsigned_t<ElemType>;
#endif

    %(op_decl)s;
    %(op_rd)s;

#if %(is_vecSeg)s
    RiscvISA::vreg_t vtmp_s[8];  // 最多8个vtemp
    for (uint8_t src_idx = 0; src_idx < vregsrcNum; src_idx++) {
        xc->getRegOperand(this, src_idx + vregsrcIdx, &vtmp_s[src_idx]);
    }
    const size_t chunk_nf = vregsrcNum;
#endif

    Addr EA;

#if %(is_vecIndex)s
    uint32_t vs2ElemIdx = vmi.rs % (DPLEN / eew);
#endif

    %(ea_code)s;

    uint32_t eew_ = eew;
#if %(is_vecIndex)s
    eew_ = sizeof(vu) * 8;
#endif
    const uint32_t eewb = eew_/8;

    %(divrVl)s;

    // Vse constructor uses flattened field indices for rs/re.
#if %(is_vse)s
    uint32_t mem_size = (vmi.re - vmi.rs) * eewb;
#else
    // VsStride/VsIndex constructors use segment indices for rs/re.
    uint32_t mem_size = (vmi.re - vmi.rs) * chunk_nf * eewb;
#endif
    panic_if(mem_size > DPLENB,
             "%s initiateAcc mem_size=%u exceeds DPLENB=%u",
             mnemonic, mem_size, (uint32_t)DPLENB);

#if %(is_vecWhole)s
#else
    VM_REQUIRED();
#endif

    std::vector<bool> byte_enable(mem_size, false);

#if %(is_vse)s
    auto start_idx = vmi.rs;
#else
    auto start_idx = vmi.rs * chunk_nf;
#endif

    size_t ei;
    for (size_t i = 0; i < mem_size / eewb; i++) {
        uint32_t elem_idx = i + start_idx;
        uint32_t idx = elem_idx / chunk_nf;
        uint32_t vreg_idx = elem_idx % chunk_nf;
        uint32_t vs3ElemIdx = (idx % (DPLEN / eew_));
        ei = idx;
        if (%(wb_elem_mask)s) {
#if %(is_vecSeg)s
            // 为segment store根据eew_使用正确类型的指针
            switch (eew_) {
                case 8: {
                    auto Vs3 = vtmp_s[vreg_idx].as<uint8_t>();
                    %(memacc_code)s;
                    break;
                }
                case 16: {
                    auto Vs3 = vtmp_s[vreg_idx].as<uint16_t>();
                    %(memacc_code)s;
                    break;
                }
                case 32: {
                    auto Vs3 = vtmp_s[vreg_idx].as<uint32_t>();
                    %(memacc_code)s;
                    break;
                }
                case 64: {
                    auto Vs3 = vtmp_s[vreg_idx].as<uint64_t>();
                    %(memacc_code)s;
                    break;
                }
                default:
                    assert(0 && "invalid eew for vec store.");
            }
#else
            %(memacc_code)s;
#endif
            auto it = byte_enable.begin() + i * eewb;
            std::fill(it, it + eewb, true);
        }
    }


    Fault fault = NoFault;
    if (mem_size > 0) {
        fault = xc->writeMem(Mem.as<uint8_t>(), mem_size, EA, memAccessFlags,
                            nullptr, byte_enable);
    }
    return fault;
}

}};

def template VlmMicroDeclare {{

class %(class_name)s : public VleMicroInst
{
private:
    RegId srcRegIdxArr[8];
    RegId destRegIdxArr[1];
public:
    %(class_name)s(ExtMachInst _machInst, uint8_t _microIdx, VectorMicroInfo& _vmi)
    : VleMicroInst("%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        vmi = _vmi;
        assert(~vmi.microVd);
        assert(~vmi.offset);
        assert(vmi.microVd < NumVecBufRegs);
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setDestRegIdx(_numDestRegs++, RegId(VecBufRegClass, vmi.microVd));
        _numTypedDestRegs[VecBufRegClass]++;
        setSrcRegIdx(_numSrcRegs++, RegId(IntRegClass, _machInst.rs1));
        SET_VL_SRC();
        SET_VM_SRC();

        this->flags[IsVector] = true;
    }

    Fault execute(ExecContext *, Trace::InstRecord *) const override;
    Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
    Fault completeAcc(PacketPtr, ExecContext *,
                      Trace::InstRecord *) const override;
    using VleMicroInst::generateDisassembly;

};

}};

def template VlmMicroExecute {{

Fault
%(class_name)s::execute(ExecContext *xc, Trace::InstRecord *traceData) const
{
    %(op_decl)s;
    %(op_rd)s;

    Addr EA;
    // EA = Rs1 + vmi.offset;
    %(ea_code)s;

    uint32_t elem_num_per_vreg = DPLEN / eew;
    uint32_t mem_size = calc_memsize(vmi.rs, vmi.re, eew, rVl);

    VM_REQUIRED();

    std::vector<bool> byte_enable(mem_size, true);
    Fault fault = xc->readMem(EA, Mem.as<uint8_t>(), mem_size, memAccessFlags,
                              byte_enable);
    if (fault != NoFault)
        return fault;

    for (size_t i = 0; i < vmi.re - vmi.rs; i++) {
        uint32_t vdElemIdx = (vmi.rs % elem_num_per_vreg) + i;
        %(memacc_code)s;
    }

    %(op_wb)s;
    return fault;
}

}};

def template VlmMicroCompleteAcc {{

Fault
%(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
                            Trace::InstRecord *traceData) const
{
    %(op_decl)s;
    %(op_rd)s;

    VM_REQUIRED();
    bool vm_zero = !this->vm &&
        popcount_in_byte((uint64_t*)tmp_v0_storage, vmi.rs, vmi.re) == 0;

    const uint32_t eew_ = eew;
    const uint32_t eewb = eew_ / 8;
    uint32_t mem_size = %(calc_memsize_code)s;
    if (vmi.rs >= rVl) {
        mem_size = 0;
    }
    mem_size = vm_zero ? 0 : mem_size;

    if (pkt) {
        memcpy(Mem.as<uint8_t>(), pkt->getPtr<uint8_t>(), pkt->getSize());
        assert(mem_size == pkt->getSize());
    } else {
        assert(mem_size == 0);
    }

    %(divrVl)s;

    for (size_t i = 0; i < mem_size / eewb; i++) {
        uint32_t vdElemIdx = (vmi.rs % (DPLEN / eew_)) + i;
        size_t ei = i + vmi.rs;
        if (%(wb_elem_mask)s) {
            %(memacc_code)s;
        }
    }

    %(tail_agnostic_code)s;
    %(vfof_get_code)s;
    %(op_wb)s;
    return NoFault;
}

}};

def template VsmConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    const int32_t nf = _machInst.nf + 1;
    eew = 8;
    _machInst.width = 0;
    const uint32_t emul = 1;
    const uint32_t elem_num_per_bank = DPLEN / eew;
    const uint32_t vreg_banks = VLEN / DPLEN;
    // panic_if(nf * emul > 8, "invalid nf and emul");

    StaticInstPtr microop;
    VectorMicroInfo vmi;
    if (nf == 1) {
        const uint32_t active_mask_banks = calculateActiveMaskMemBanks(sew, vflmul);
        for (uint32_t i=0; i<active_mask_banks; i++) {
            vmi.rs = i * elem_num_per_bank;
            vmi.re = (i + 1) * elem_num_per_bank;
            vmi.microVs3 = VS3 * VregBanks + i;
            vmi.offset = i * DPLENB;
            microop = new Vsm_vMicro(_machInst, i, vmi);
            microop->setDelayedCommit();
            microop->setFlag(IsStore);
            microop->setNF(nf);
            this->microops.push_back(microop);
        }
    } else {
        // TODO
        panic("not implemented");
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VsmMicroDeclare {{

