        setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass, vmi.microVs3));
        SET_VL_SRC();  // 声明rVl操作数以满足模板要求，但whole register指令不实际使用vl
        this->flags[IsVector] = true;
        this->flags[IsStore] = true;
    }
    Fault execute(ExecContext *, Trace::InstRecord *) const override;
    Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
    Fault completeAcc(PacketPtr, ExecContext *,
                        Trace::InstRecord *) const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VsStrideConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    const int32_t nf = _machInst.nf + 1;
    const uint32_t eew = width_EEW(_machInst.width);
    const uint32_t sew = getSew(_machInst.vtype8.vsew);
    const uint32_t emul = get_emul(eew, sew, vflmul, false);
    const uint32_t elem_num_per_vreg = VLEN / eew;
    const uint32_t elem_num_per_bank = DPLEN / eew;
    const uint32_t bytes_per_elem = eew / 8;
    const uint32_t max_fields_per_store =
        std::max(1u, static_cast<uint32_t>(DPLENB / bytes_per_elem));
    // panic_if(nf * emul > 8, "invalid nf and emul");

    StaticInstPtr microop;
    VectorMicroInfo vmi;
    uint32_t vlmax = calculateVlmax(VLEN, sew, vflmul);
    if (_machInst.vlKnown) {
        vlmax = std::min(vlmax, static_cast<uint32_t>(_machInst.vlValue));
    }
    vlmax = std::min(vlmax, calculateActiveElemSpan(eew, sew, vflmul));
    uint32_t store_micro_idx = 0;

    // baseAddr = Rs1 + i*Rs2
    // mem<eew>[baseAddr+eewb*0] = (vs3+emul*0)<eew>[i];
    // mem<eew>[baseAddr+eewb*1] = (vs3+emul*1)<eew>[i];
    // mem<eew>[baseAddr+eewb*nf] = (vs3+emul*nf)<eew>[i];
    for (int i=0; i < vlmax; i++) {
        vmi.rs = i;
        vmi.re = (i + 1);
        uint32_t arch_reg = VS3 + i / elem_num_per_vreg;
        uint32_t bank = (i % elem_num_per_vreg) / elem_num_per_bank;
        vmi.microVs3 = arch_reg * VregBanks + bank;
        for (uint32_t fbase = 0; fbase < static_cast<uint32_t>(nf);
             fbase += max_fields_per_store) {
            const uint32_t field_writes = std::min(
                max_fields_per_store, static_cast<uint32_t>(nf) - fbase);
            vmi.fn = 0;
            vmi.microVs3 = arch_reg * VregBanks + bank + fbase * emul * VregBanks;
            vmi.offset = fbase * bytes_per_elem;
            microop = new %(class_name)sMicro(_machInst, field_writes,
                                              store_micro_idx++, vmi);
            microop->setDelayedCommit();
            microop->setFlag(IsStore);
            microop->setNF(nf);
            this->microops.push_back(microop);
        }
    }

    this->microops.front()->setFlag(IsFirstMicroop);
    this->microops.back()->setFlag(IsLastMicroop);
}

}};

def template VsStrideMicroDeclare {{

class %(class_name)s : public %(base_class)s
{
private:
    // rs1, rs2, vs3, vm
    RegId srcRegIdxArr[16];
    RegId destRegIdxArr[0];
public:
    %(class_name)s(ExtMachInst _machInst, uint8_t vsrc_num, uint8_t _microIdx, VectorMicroInfo& _vmi)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        vmi = _vmi;
        assert(~vmi.microVs3);
        assert(~vmi.offset);
        assert(vmi.microVs3 < NumVecStandardRegs);
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setSrcRegIdx(_numSrcRegs++, RegId(IntRegClass, _machInst.rs1));
        setSrcRegIdx(_numSrcRegs++, RegId(IntRegClass, _machInst.rs2));
        vregsrcIdx = _numSrcRegs;
        vregsrcNum = vsrc_num;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        for (uint8_t i=0; i<vregsrcNum; i++) {
            RegIndex src_idx = vmi.microVs3 + i * emul * VregBanks;
            assert(src_idx < NumVecStandardRegs);
            setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass, src_idx));
        }
        SET_VL_SRC();
        SET_VM_SRC();
        this->flags[IsVector] = true;
        this->flags[IsStore] = true;
    }

    Fault execute(ExecContext *, Trace::InstRecord *) const override;
    Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
    Fault completeAcc(PacketPtr, ExecContext *,
                      Trace::InstRecord *) const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VsIndexConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    const int32_t nf = _machInst.nf + 1;
    const uint32_t emul = get_emul(sew, sew, vflmul, false);    // 注意vsrc使用sew
    const uint32_t flmul = vflmul < 1 ? 1 : vflmul;
    const uint32_t elem_num_per_vreg = VLEN / sew;
    const uint32_t elem_num_per_bank = DPLEN / sew;
    const uint32_t vs2_elts_per_vreg = VLEN / eew;
    const uint32_t vs2_elts_per_bank = DPLEN / eew;
    const uint32_t bytes_per_elem = sew / 8;
    const uint32_t max_fields_per_store =
        std::max(1u, static_cast<uint32_t>(DPLENB / bytes_per_elem));
    // panic_if(nf * flmul > 8, "invalid nf and emul");

    StaticInstPtr microop;
    VectorMicroInfo vmi;
    uint32_t vlmax = calculateVlmax(VLEN, sew, vflmul);
    if (_machInst.vlKnown) {
        vlmax = std::min(vlmax, static_cast<uint32_t>(_machInst.vlValue));
    }
    vlmax = std::min(vlmax, calculateActiveElemSpan(sew, sew, vflmul));
    uint32_t store_micro_idx = 0;
    for (int i=0; i < vlmax; i++) {
        vmi.rs = i;
        vmi.re = (i + 1);
        uint32_t arch_vs2 = elem_gen_idx(VS2, i, eew / 8);
        uint32_t arch_vs3 = VS3 + i / elem_num_per_vreg;
        vmi.microVs2 = arch_vs2 * VregBanks + (i % vs2_elts_per_vreg) / vs2_elts_per_bank;
        vmi.microVs3 = arch_vs3 * VregBanks + (i % elem_num_per_vreg) / elem_num_per_bank;
        for (uint32_t fbase = 0; fbase < static_cast<uint32_t>(nf);
             fbase += max_fields_per_store) {
            const uint32_t field_writes = std::min(
                max_fields_per_store, static_cast<uint32_t>(nf) - fbase);
            vmi.fn = 0;
            vmi.microVs3 =
                arch_vs3 * VregBanks +
                (i % elem_num_per_vreg) / elem_num_per_bank +
                fbase * emul * VregBanks;
            vmi.offset = fbase * bytes_per_elem;
            microop = new %(class_name)sMicro<ElemType>(
                _machInst, field_writes, store_micro_idx++, vmi);
            microop->setDelayedCommit();
            microop->setFlag(IsStore);
            microop->setNF(nf);
            this->microops.push_back(microop);
        }
    }

    this->microops.front()->setFlag(IsFirstMicroop);
    this->microops.back()->setFlag(IsLastMicroop);
    this->flags[IsVector] = true;
}

}};

def template VsIndexMicroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    // rs1, vs2, vs3, vm
    RegId srcRegIdxArr[16];
    RegId destRegIdxArr[0];
public:
    %(class_name)s(ExtMachInst _machInst, uint8_t vsrc_num, uint8_t _microIdx, VectorMicroInfo& _vmi)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        vmi = _vmi;
        assert(~vmi.fn);
        assert(~vmi.microVs2);
        assert(~vmi.microVs3);
        assert(~vmi.offset);
        assert(vmi.microVs2 < NumVecStandardRegs);
        assert(vmi.microVs3 < NumVecStandardRegs);
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setSrcRegIdx(_numSrcRegs++, RegId(IntRegClass, _machInst.rs1));
        setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass, vmi.microVs2));
        vregsrcIdx = _numSrcRegs;
        vregsrcNum = vsrc_num;
        const uint32_t emul = get_emul(sew, sew, vflmul, false);  // 注意vsrc使用sew
        for (uint8_t i=0; i<vregsrcNum; i++) {
            RegIndex src_idx = vmi.microVs3 + i * emul * VregBanks;
            assert(src_idx < NumVecStandardRegs);
            setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass, src_idx));
        }
        SET_VL_SRC();
        SET_VM_SRC();
        this->flags[IsVector] = true;
        this->flags[IsStore] = true;
    }

    Fault execute(ExecContext *, Trace::InstRecord *) const override;
    Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
    Fault completeAcc(PacketPtr, ExecContext *,
                      Trace::InstRecord *) const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VMemTemplateDecodeBlock {{
    {
        const uint32_t sew = 8 << machInst.vtype8.vsew;
        const float vflmul = getVflmul(machInst.vtype8.vlmul);
        const uint32_t eew = width_EEW(machInst.width);
        const int32_t nf = machInst.nf + 1;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        const uint32_t flmul = vflmul < 1 ? 1 : (uint32_t)vflmul;
        if (emul > 8 || emul * nf > 8) {
            return new Unknown(machInst);
        }
        uint32_t max_reg = machInst.vd + nf * flmul - 1;
        if (max_reg >= 32) {
            return new Unknown(machInst);
        }

        switch(machInst.vtype8.vsew) {
            case 0b000: return new %(class_name)s<uint8_t>(machInst);
            case 0b001: return new %(class_name)s<uint16_t>(machInst);
            case 0b010: return new %(class_name)s<uint32_t>(machInst);
            case 0b011: return new %(class_name)s<uint64_t>(machInst);
            default: return new Unknown(machInst);
        }
    }
}};

def template VMemValidateDecodeBlock {{
    {
        const uint32_t sew = 8 << machInst.vtype8.vsew;
        const float vflmul = getVflmul(machInst.vtype8.vlmul);
        const uint32_t eew = width_EEW(machInst.width);
        const int32_t nf = machInst.nf + 1;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        if (emul > 8 || emul * nf > 8) {
            return new Unknown(machInst);

        }

        // Validate segment destination fields with EMUL granularity.
        // This matches stride/index decode behavior and avoids over-strict
        // alignment on whole-group checks for fractional LMUL cases.
        for (int i = 0; i < nf; i++) {
            uint32_t field_start = machInst.vd + i * emul;
            if (!check_vreg_idx_valid(field_start, emul, true)) {
                return new Unknown(machInst);
            }
        }

        return new %(class_name)s(machInst);
    }
}};

def template VlWholeDecodeBlock {{
    {
        const int32_t nf = machInst.nf + 1;
        if (!check_vreg_idx_valid(machInst.vd, nf, true)) {
            return new Unknown(machInst);
        }

        return new %(class_name)s(machInst);
    }
}};

def template VsWholeDecodeBlock {{
    {
        const int32_t nf = machInst.nf + 1;
        if (!check_vreg_idx_valid(machInst.vs3, nf, true)) {
            return new Unknown(machInst);
        }

        return new %(class_name)s(machInst);
    }
}};

def template VlStrideDecodeBlock {{
    {
        const uint32_t sew = 8 << machInst.vtype8.vsew;
        const float vflmul = getVflmul(machInst.vtype8.vlmul);
        const uint32_t eew = width_EEW(machInst.width);
        const int32_t nf = machInst.nf + 1;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        if (emul > 8 || emul * nf > 8) {
            return new Unknown(machInst);
        }

        // Segment alignment is checked per-field with EMUL granularity.
        for (int i = 0; i < nf; i++) {
            uint32_t field_start = machInst.vd + i * emul;
            if (!check_vreg_idx_valid(field_start, emul, true)) {
                return new Unknown(machInst);
            }
        }

        return new %(class_name)s(machInst);
    }
}};

def template VlIndexDecodeBlock {{
    {
        const uint32_t sew = 8 << machInst.vtype8.vsew;
        const float vflmul = getVflmul(machInst.vtype8.vlmul);
        const uint32_t eew = width_EEW(machInst.width);
        const int32_t nf = machInst.nf + 1;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        const uint32_t seg_emul = get_emul(sew, sew, vflmul, false);
        const uint32_t vs2_regs = std::max<uint32_t>(1, (uint32_t)((float)eew * vflmul / (float)sew));

        if (emul > 8 || seg_emul * nf > 8) {
            return new Unknown(machInst);
        }

        for (int i = 0; i < nf; i++) {
            uint32_t field_start = machInst.vd + i * seg_emul;
            if (!check_vreg_idx_valid(field_start, seg_emul, true)) {
                return new Unknown(machInst);
            }
        }
        if (!check_vreg_idx_valid(machInst.vs2, vs2_regs, true)) {
            return new Unknown(machInst);
        }

        switch(machInst.vtype8.vsew) {
            case 0b000: return new %(class_name)s<uint8_t>(machInst);
            case 0b001: return new %(class_name)s<uint16_t>(machInst);
            case 0b010: return new %(class_name)s<uint32_t>(machInst);
            case 0b011: return new %(class_name)s<uint64_t>(machInst);
            default: return new Unknown(machInst);
        }
    }
}};

def template VsStrideDecodeBlock {{
    {
        const uint32_t sew = 8 << machInst.vtype8.vsew;
        const float vflmul = getVflmul(machInst.vtype8.vlmul);
        const uint32_t eew = width_EEW(machInst.width);
        const int32_t nf = machInst.nf + 1;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        if (emul > 8 || emul * nf > 8) {
            return new Unknown(machInst);
        }

        // Segment alignment is checked per-field with EMUL granularity.
        for (int i = 0; i < nf; i++) {
            uint32_t field_start = machInst.vs3 + i * emul;
            if (!check_vreg_idx_valid(field_start, emul, true)) {
                return new Unknown(machInst);
            }
        }

        return new %(class_name)s(machInst);
    }
}};

def template VsIndexDecodeBlock {{
    {
        const uint32_t sew = 8 << machInst.vtype8.vsew;
        const float vflmul = getVflmul(machInst.vtype8.vlmul);
        const uint32_t eew = width_EEW(machInst.width);
        const int32_t nf = machInst.nf + 1;
        const uint32_t emul = get_emul(eew, sew, vflmul, false);
        const uint32_t seg_emul = get_emul(sew, sew, vflmul, false);
        const uint32_t vs2_regs = std::max<uint32_t>(1, (uint32_t)((float)eew * vflmul / (float)sew));

        if (emul > 8 || seg_emul * nf > 8) {
            return new Unknown(machInst);
        }

        for (int i = 0; i < nf; i++) {
            uint32_t field_start = machInst.vs3 + i * seg_emul;
            if (!check_vreg_idx_valid(field_start, seg_emul, true)) {
                return new Unknown(machInst);
            }
        }
        if (!check_vreg_idx_valid(machInst.vs2, vs2_regs, true)) {
            return new Unknown(machInst);
        }

        switch(machInst.vtype8.vsew) {
            case 0b000: return new %(class_name)s<uint8_t>(machInst);
            case 0b001: return new %(class_name)s<uint16_t>(machInst);
            case 0b010: return new %(class_name)s<uint32_t>(machInst);
            case 0b011: return new %(class_name)s<uint64_t>(machInst);
            default: return new Unknown(machInst);
        }
    }
}};
