let {{

def VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                base_class, postacc_code='', declare_template_base=VMemMacroDeclare,
                decode_template=BasicDecode, exec_template_base='',
                vfof=False, is_macroop=True):
    # If it's a macroop, the corresponding microops will be
    # generated.
    # Make sure flags are in lists (convert to lists if not).
    base_type = base_class
    base_class += 'MacroInst'

    mem_flags = makeList(mem_flags)
    inst_flags = makeList(inst_flags)
    iop = InstObjParams(name, Name, base_class,
        {'ea_code': ea_code,
         'memacc_code': memacc_code,
         'postacc_code': postacc_code },
        inst_flags)

    constructTemplate = eval(exec_template_base + 'Constructor')

    header_output   = declare_template_base.subst(iop)
    decoder_output  = ''
    if declare_template_base is not VMemTemplateMacroDeclare:
        decoder_output  += constructTemplate.subst(iop)
    else:
        header_output   += constructTemplate.subst(iop)
    decode_block    = decode_template.subst(iop)
    exec_output     = ''
    if not is_macroop:
        return (header_output, decoder_output, decode_block, exec_output)

    vfof_set_code = ''
    vfof_zero_idx_check_code = ''
    vfof_get_code = ''
    if vfof:
        vfof_set_code = '''
        auto base_addr = Rs1;
        uint32_t elem_size = (eew / 8);
        const uint32_t nf = machInst.nf + 1;
        if (fault != NoFault) {
            auto addr_fault = dynamic_cast<AddressFault*>(fault.get());
            assert(addr_fault != nullptr);
            if (addr_fault) {
                auto fault_addr = addr_fault->trap_value();
                assert(fault_addr >= EA);
                uint64_t raw_fault_elem_idx = (fault_addr - base_addr) / elem_size;
                // For segment ff loads, vl is counted in segments rather than
                // scalar fields. Convert memory element index to segment index.
                if (nf > 1) {
                    raw_fault_elem_idx /= nf;
                }
                *fault_elem_idx = raw_fault_elem_idx;
            }
        } else {
            *fault_elem_idx = 0;
        }
        '''
        vfof_zero_idx_check_code = '''
        if (fault != NoFault && *fault_elem_idx == 0)
            return fault;
        '''
        vfof_get_code = '''
        Vfof_ud[0] = *fault_elem_idx;
        '''

    vecWhole = base_type == 'VlWhole' or base_type == 'VsWhole'
    vecIndex = base_type == 'VlIndex' or base_type == 'VsIndex'
    vecStride = base_type == 'VlStride' or base_type == 'VsStride'
    vecSMask = exec_template_base == 'Vlm' or exec_template_base == 'Vsm'
    vecStore = (
        base_type == 'VsWhole' or base_type == 'VsIndex' or
        base_type == 'VsStride' or exec_template_base == 'Vsm'
    )
    vecSegStore = base_type == 'Vse'or base_type == 'VsIndex' or base_type == 'VsStride'

    # Initialize variables so every branch has a definition.
    is_vecWhole = 'false'
    is_vecIndex = 'false'
    is_vecCopy = 'false'
    is_vecSeg = 'false'
    is_vse = 'false'

    if vecWhole:
        # 注意：这里添加(void)rVl是为了让ISA解析器将rVl添加到操作数列表中
        # whole register指令不实际使用vl，但模板中的vl检查代码需要rVl操作数
        calc_memsize_code = '((void)rVl, DPLENB)'
        is_vecWhole = 'true'
        wb_elem_mask = 'true'
    elif vecStride and base_type == 'VlStride':
        # 注意：这里使用rVl是为了让ISA解析器将rVl添加到操作数列表中
        # 实际的内存大小计算在execute模板中完成
        calc_memsize_code = 'calc_memsize(vmi.rs, vmi.re, eew_, rVl)'
        # calc_memsize_code = 'std::min((vmi.re - vmi.rs) * getNF(), DPLENB)'
        is_vecCopy = 'true'
        wb_elem_mask = 'true'
    elif vecIndex and base_type == 'VlIndex':
        # 注意：这里使用rVl是为了让ISA解析器将rVl添加到操作数列表中
        # 实际的内存大小计算在execute模板中完成
        calc_memsize_code = 'calc_memsize(vmi.rs, vmi.re, eew_, rVl)'
        # calc_memsize_code = 'std::min((vmi.re - vmi.rs) * getNF(), DPLENB)'
        is_vecCopy = 'true'
        wb_elem_mask = 'true'
    elif vecStore and (exec_template_base == 'VsIndex' or exec_template_base == 'VsStride'):
        is_vecSeg = 'true'
        calc_memsize_code = 'calc_memsize(vmi.rs*nf, vmi.re*nf, eew_, rVl*nf)'
        wb_elem_mask = '(ei < rVl) && (this->vm || elem_mask(v0, ei))'
    elif base_type == 'Vse':
        is_vecSeg = 'true'
        is_vse = 'true'
        calc_memsize_code = 'calc_memsize(vmi.rs, vmi.re, eew_, rVl*nf)'
        wb_elem_mask = '(ei < rVl) && (this->vm || elem_mask(v0, ei))'
    else:
        calc_memsize_code = 'calc_memsize(vmi.rs, vmi.re, eew_, rVl)'
        wb_elem_mask = '(ei < rVl) && (this->vm || elem_mask(v0, ei))'

    if vecStore and base_type != 'VsWhole' and base_type != 'Vse':
        wb_elem_mask = '(ei < rVl) && (this->vm || elem_mask(v0, ei))'

    if vecIndex:
        is_vecIndex = 'true'

    if vecStore and (exec_template_base == 'VsIndex' or exec_template_base == 'VsStride'):
        recalc_idx = '''
        auto start_idx = vmi.rs * nf;
        '''
    else:
        recalc_idx = '''
        auto start_idx = vmi.rs;
        '''

    if vecSMask:
        divrVl = 'rVl = (rVl + 7) / 8'
        is_vecSMask = 'true'
        tail_agnostic_code = '''// Tail-agnostic: 设置 ei >= vl 的位为 1, 对齐nemu实现
        if (RVV_AGNOSTIC && rVl > 0) {
            for (uint32_t byte_idx = rVl; byte_idx < VLEN / 8; byte_idx++) {
                Vd[byte_idx] = 0xff;
            }
        }'''
    else:
        divrVl = ''
        is_vecSMask = 'false'
        tail_agnostic_code = ''  # 非mask指令不需要tail处理

    microiop = InstObjParams(name + '_micro',
        Name + 'Micro',
        exec_template_base + 'MicroInst',
        {
            'ea_code'       : ea_code,
            'memacc_code'   : memacc_code,
            'postacc_code'  : postacc_code,

            'vfof_set_code' : vfof_set_code,
            'vfof_zero_idx_check_code' : vfof_zero_idx_check_code,
            'vfof_get_code' : vfof_get_code,

            'calc_memsize_code' : calc_memsize_code,
            'is_vecWhole'   : is_vecWhole,
            'is_vecIndex'   : is_vecIndex,
            'is_vecSMask'   : is_vecSMask,
            'is_vecCopy'    : is_vecCopy,
            'is_vecSeg'     : is_vecSeg,
            'is_vse'        : is_vse,

            'wb_elem_mask'  : wb_elem_mask,

            'recalc_idx'    : recalc_idx,
            'divrVl'        : divrVl,
            'tail_agnostic_code' : tail_agnostic_code
        },
        inst_flags)

    if mem_flags:
        mem_flags = [ 'Request::%s' % flag for flag in mem_flags ]
        s = '\n\tmemAccessFlags = ' + '|'.join(mem_flags) + ';'
        microiop.constructor += s

    if base_type.startswith('Vl'):
        exe_template_base  = exec_template_base
        init_template_base = 'Vload'
        comp_template_base = 'Vload'
    else:
        exe_template_base  = 'Vstore'
        init_template_base = 'Vstore'
        comp_template_base = 'Vstore'

    # 添加对Vle的特殊处理，使用简化的模版（不处理mask和tail）
    if exec_template_base == 'Vle':
        init_template_base = 'Vle'
        comp_template_base = 'Vle'
    elif exec_template_base == 'Vlm':
        comp_template_base = 'Vlm'
    elif exec_template_base == 'VlWhole':
        comp_template_base = 'VlWhole'
    elif exec_template_base == 'VlStride':
        init_template_base = 'VlStride'
        comp_template_base = 'VlStride'
    elif exec_template_base == 'VlIndex':
        init_template_base = 'VlIndex'
        comp_template_base = 'VlIndex'
    elif exec_template_base == 'Vleff':
        init_template_base = 'Vleff'
        comp_template_base = 'Vleff'

    # vse直接做segment处理数据
    if exec_template_base == 'Vse' or exec_template_base == 'VsIndex' or exec_template_base == 'VsStride':
        init_template_base = 'Vsseg'

    microDeclTemplate = eval(exec_template_base + 'Micro' + 'Declare')
    microExecTemplate = eval(exe_template_base + 'Micro' + 'Execute')
    microInitTemplate = eval(init_template_base + 'Micro' + 'InitiateAcc')
    microCompTemplate = eval(comp_template_base + 'Micro' + 'CompleteAcc')
    header_output = microDeclTemplate.subst(microiop) + header_output
    micro_exec_output = (microExecTemplate.subst(microiop) +
        microInitTemplate.subst(microiop) +
        microCompTemplate.subst(microiop))
    if declare_template_base is not VMemTemplateMacroDeclare:
        exec_output += micro_exec_output
    else:
        header_output += micro_exec_output

    return (header_output, decoder_output, decode_block, exec_output)

}};

def format VleOp(
    memacc_code,
    ea_code={{ EA = Rs1 + vmi.offset; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'Vle', decode_template=VMemValidateDecodeBlock,
                exec_template_base='Vle')
}};

def format VleffOp(
    memacc_code,
    ea_code={{ EA = Rs1 + vmi.offset; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'Vle', decode_template=VMemValidateDecodeBlock,
                exec_template_base='Vleff', vfof=True)
}};

def format VlmOp(
    memacc_code,
    ea_code={{ EA = Rs1; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'Vle', exec_template_base='Vlm')
}};

def format VlWholeOp(
    memacc_code,
    ea_code={{ EA = Rs1 + DPLENB * microIdx; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'VlWhole', decode_template=VlWholeDecodeBlock,
                exec_template_base='VlWhole')
}};

def format VlStrideOp(
    memacc_code,
    ea_code={{ EA = Rs1 + Rs2*vmi.rs + vmi.offset; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'VlStride', decode_template=VlStrideDecodeBlock, exec_template_base='VlStride')
}};


def format VlIndexOp(
    memacc_code,
    ea_code,
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'VlIndex', declare_template_base=VMemTemplateMacroDeclare,
                decode_template=VlIndexDecodeBlock,
                exec_template_base='VlIndex')
}};

def format VseOp(
    memacc_code,
    ea_code={{ EA = Rs1 + vmi.offset; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'Vse', decode_template=VMemValidateDecodeBlock,
                exec_template_base='Vse')
}};

def format VsmOp(
  memacc_code,
  ea_code={{ EA = Rs1; }},
  mem_flags=[],
  inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'Vse', exec_template_base='Vsm')
}};

def format VsWholeOp(
    memacc_code,
    ea_code={{ EA = Rs1 + DPLENB * microIdx; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'VsWhole', decode_template=VsWholeDecodeBlock,
                exec_template_base='VsWhole')
}};

def format VsStrideOp(
    memacc_code,
    ea_code={{ EA = Rs1 + Rs2*vmi.rs + vmi.offset; }},
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'VsStride', decode_template=VsStrideDecodeBlock,
                exec_template_base='VsStride')
}};

def format VsIndexOp(
    memacc_code,
    ea_code,
    mem_flags=[],
    inst_flags=[]
) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        VMemBase(name, Name, ea_code, memacc_code, mem_flags, inst_flags,
                'VsIndex', declare_template_base=VMemTemplateMacroDeclare,
                decode_template=VsIndexDecodeBlock, exec_template_base='VsIndex')
}};
