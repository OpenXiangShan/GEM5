                    0x1f: vmfge_vf({{
                        Vd_ub[(i + offset)/8] = ASSIGN_VD_BIT(i + offset,
                            fle<et>(ftype_freg<et>(freg(Fs1_bits)),
                                    ftype<et>(Vs2_vu[i])));
                    }}, OPFVF, VectorFloatCmpOp);
                }
                format VectorFloatFormat{
                    0x20: vfdiv_vf({{
                        auto fd = fdiv<et>(ftype<et>(Vs2_vu[i]),
                                           ftype_freg<et>(freg(Fs1_bits)));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatDivOp);
                    0x21: vfrdiv_vf({{
                        auto fd = fdiv<et>(ftype_freg<et>(freg(Fs1_bits)),
                                           ftype<et>(Vs2_vu[i]));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatDivOp);
                    0x24: vfmul_vf({{
                        auto fd = fmul<et>(ftype<et>(Vs2_vu[i]),
                                           ftype_freg<et>(freg(Fs1_bits)));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultOp);
                    0x27: vfrsub_vf({{
                        auto fd = fsub<et>(ftype_freg<et>(freg(Fs1_bits)),
                                           ftype<et>(Vs2_vu[i]));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatArithOp);
                    0x28: vfmadd_vf({{
                        auto fd = fmadd<et>(ftype<et>(Vs3_vu[i]),
                                            ftype_freg<et>(freg(Fs1_bits)),
                                            ftype<et>(Vs2_vu[i]));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x29: vfnmadd_vf({{
                        auto fd = fmadd<et>(fneg(ftype<et>(Vs3_vu[i])),
                                            ftype_freg<et>(freg(Fs1_bits)),
                                            fneg(ftype<et>(Vs2_vu[i])));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x2a: vfmsub_vf({{
                        auto fd = fmadd<et>(ftype<et>(Vs3_vu[i]),
                                            ftype_freg<et>(freg(Fs1_bits)),
                                            fneg(ftype<et>(Vs2_vu[i])));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x2b: vfnmsub_vf({{
                        auto fd = fmadd<et>(fneg(ftype<et>(Vs3_vu[i])),
                                            ftype_freg<et>(freg(Fs1_bits)),
                                            ftype<et>(Vs2_vu[i]));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x2c: vfmacc_vf({{
                        auto fd = fmadd<et>(ftype_freg<et>(freg(Fs1_bits)),
                                            ftype<et>(Vs2_vu[i]),
                                            ftype<et>(Vs3_vu[i]));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x2d: vfnmacc_vf({{
                        auto fd = fmadd<et>(fneg(ftype_freg<et>(freg(Fs1_bits))),
                                            ftype<et>(Vs2_vu[i]),
                                            fneg(ftype<et>(Vs3_vu[i])));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x2e: vfmsac_vf({{
                        auto fd = fmadd<et>(ftype_freg<et>(freg(Fs1_bits)),
                                            ftype<et>(Vs2_vu[i]),
                                            fneg(ftype<et>(Vs3_vu[i])));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x2f: vfnmsac_vf({{
                        auto fd = fmadd<et>(fneg(ftype_freg<et>(freg(Fs1_bits))),
                                            ftype<et>(Vs2_vu[i]),
                                            ftype<et>(Vs3_vu[i]));
                        Vd_vu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                }
                format VectorFloatWideningFormat {
                    0x30: vfwadd_vf({{
                        auto fd = fadd<ewt>(
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            fwiden(ftype_freg<et>(freg(Fs1_bits))));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatArithOp);
                    0x32: vfwsub_vf({{
                        auto fd = fsub<ewt>(
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            fwiden(ftype_freg<et>(freg(Fs1_bits))));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatArithOp);
                    0x34: vfwadd_wf({{
                        auto fd = fadd<ewt>(
                            ftype<ewt>(Vs2_vwu[i]),
                            fwiden(ftype_freg<et>(freg(Fs1_bits))));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatArithOp);
                    0x36: vfwsub_wf({{
                        auto fd = fsub<ewt>(
                            ftype<ewt>(Vs2_vwu[i]),
                            fwiden(ftype_freg<et>(freg(Fs1_bits))));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatArithOp);
                    0x38: vfwmul_vf({{
                        auto fd = fmul<ewt>(
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            fwiden(ftype_freg<et>(freg(Fs1_bits))));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultOp);
                    0x3c: vfwmacc_vf({{
                        auto fd = fmadd<ewt>(
                            fwiden(ftype_freg<et>(freg(Fs1_bits))),
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            ftype<ewt>(Vs3_vwu[i]));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x3d: vfwnmacc_vf({{
                        auto fd = fmadd<ewt>(
                            fwiden(fneg(ftype_freg<et>(freg(Fs1_bits)))),
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            fneg(ftype<ewt>(Vs3_vwu[i])));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x3e: vfwmsac_vf({{
                        auto fd = fmadd<ewt>(
                            fwiden(ftype_freg<et>(freg(Fs1_bits))),
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            fneg(ftype<ewt>(Vs3_vwu[i])));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                    0x3f: vfwnmsac_vf({{
                        auto fd = fmadd<ewt>(
                            fwiden(fneg(ftype_freg<et>(freg(Fs1_bits)))),
                            fwiden(ftype<et>(Vs2_vu[i + offset])),
                            ftype<ewt>(Vs3_vwu[i]));
                        Vd_vwu[i] = fd.v;
                    }}, OPFVF, VectorFloatMultAccOp);
                }
            }
            // OPMVX
            0x6: decode VFUNCT6 {
                format VectorIntFormat {
                    0x08: vaaddu_vx({{
                        __uint128_t res = (__uint128_t)Vs2_vu[i] + Rs1_vu;
                        res = int_rounding<__uint128_t>(res, xc->readMiscReg(MISCREG_VXRM), 1);
                        Vd_vu[i] = res >> 1;
                    }}, OPMVX, VectorArithOp);
                    0x09: vaadd_vx({{
                        __uint128_t res = (__uint128_t)Vs2_vi[i] + Rs1_vi;
                        res = int_rounding<__uint128_t>(res, xc->readMiscReg(MISCREG_VXRM), 1);
                        Vd_vi[i] = res >> 1;
                    }}, OPMVX, VectorArithOp);
                }
                0x0e: VectorSlideUpFormat::vslide1up_vx({{
                    for (uint32_t ei = vmi.rs; ei < vmi.re && ei < rVl; ei++) {
                        uint32_t local_i = ei - vmi.rs;
                        if (machInst.vm || elem_mask(v0, ei)) {
                            if (ei == 0) {
                                Vd_vu[local_i] = Rs1_vu;
                            } else {
                                Vd_vu[local_i] = vs2_full[ei - 1];
                            }
                        }
                    }
                }}, OPIVX, VectorMisc0Op);
                0x0f: VectorSlideDownFormat::vslide1down_vx({{
                    for (uint32_t ei = vmi.rs; ei < vmi.re && ei < rVl; ei++) {
                        uint32_t local_i = ei - vmi.rs;
                        if (machInst.vm || elem_mask(v0, ei)) {
                            if (ei + 1 == rVl) {
                                Vd_vu[local_i] = Rs1_vu;
                            } else {
                                Vd_vu[local_i] = (ei + 1 < rVl) ? vs2_full[ei + 1] : 0;
                            }
                        }
                    }
                }}, OPIVX, VectorMisc0Op);
                // VRXUNARY0
                0x10: decode VS2 {
                    0x00: decode VM {
                        // The encodings corresponding to the masked versions
                        // (vm=0) of vmv.s.x are reserved.
                        0x1: VectorNonSplitFormat::vmv_s_x({{
                            std::memcpy(Vd_vu, Vd_merger, RiscvISA::DPLENB);
                            if (rVl) {
                                Vd_vu[0] = Rs1_vu;
                            }
                        }}, OPMVX, VectorConvertI2IOp);
                    }
                }
                format VectorIntFormat {
                    0x0a: vasubu_vx({{
                        __uint128_t res = (__uint128_t)Vs2_vu[i] - Rs1_vu;
                        res = int_rounding<__uint128_t>(res, xc->readMiscReg(MISCREG_VXRM), 1);
                        Vd_vu[i] = res >> 1;
                    }}, OPMVX, VectorArithOp);
                    0x0b: vasub_vx({{
                        __uint128_t res = (__uint128_t)Vs2_vi[i] - Rs1_vi;
                        res = int_rounding<__uint128_t>(res, xc->readMiscReg(MISCREG_VXRM), 1);
                        Vd_vi[i] = res >> 1;
                    }}, OPMVX, VectorArithOp);
                    0x20: vdivu_vx({{
                        if (Rs1_vu == 0)
                            Vd_vu[i] = (vu)-1;
                        else
                            Vd_vu[i] = Vs2_vu[i] / Rs1_vu;
                    }}, OPMVX, VectorDivOp);
                    0x21: vdiv_vx({{
                        if (Rs1_vi == 0)
                            Vd_vi[i] = -1;
                        else if (Vs2_vi[i] == std::numeric_limits<vi>::min()
                                && Rs1_vi == -1)
                            Vd_vi[i] = Vs2_vi[i];
                        else
                            Vd_vi[i] = Vs2_vi[i] / Rs1_vi;
                    }}, OPMVX, VectorDivOp);
                    0x22: vremu_vx({{
                        if (Rs1_vu == 0)
                            Vd_vu[i] = Vs2_vu[i];
                        else
                            Vd_vu[i] = Vs2_vu[i] % Rs1_vu;
                    }}, OPMVX, VectorDivOp);
                    0x23: vrem_vx({{
                        if (Rs1_vi == 0)
                            Vd_vi[i] = Vs2_vi[i];
                        else if (Vs2_vi[i] == std::numeric_limits<vi>::min()
                                && Rs1_vi == -1)
                            Vd_vi[i] = 0;
                        else
                            Vd_vi[i] = Vs2_vi[i] % Rs1_vi;
                    }}, OPMVX, VectorDivOp);
                    0x24: vmulhu_vx({{
                        if (sew < 64)
                            Vd_vu[i] = ((uint64_t)Vs2_vu[i] * Rs1_vu)
                                        >> sew;
                        else
                            Vd_vu[i] = mulhu(Vs2_vu[i], Rs1_vu);
                    }}, OPMVX, VectorMultOp);
                    0x25: vmul_vx({{
                        Vd_vi[i] = Vs2_vi[i] * Rs1_vi;
                    }}, OPMVX, VectorMultOp);
                    0x26: vmulhsu_vx({{
                        if (sew < 64)
                            Vd_vi[i] = ((int64_t)Vs2_vi[i] *
                                        (uint64_t)Rs1_vu)
                                        >> sew;
                        else
                            Vd_vi[i] = mulhsu(Vs2_vi[i], Rs1_vu);
                    }}, OPMVX, VectorMultOp);
                    0x27: vmulh_vx({{
                        if (sew < 64)
                            Vd_vi[i] = ((int64_t)Vs2_vi[i] * Rs1_vi)
                                        >> sew;
                        else
                            Vd_vi[i] = mulh(Vs2_vi[i], Rs1_vi);
                    }}, OPMVX, VectorMultOp);
                    0x29: vmadd_vx({{
                        Vd_vi[i] = Vs3_vi[i] * Rs1_vi + Vs2_vi[i];
                    }}, OPMVX, VectorMultAccOp);
                    0x2b: vnmsub_vx({{
                        Vd_vi[i] = -(Vs3_vi[i] * Rs1_vi) + Vs2_vi[i];
                    }}, OPMVX, VectorMultAccOp);
                    0x2d: vmacc_vx({{
                        Vd_vi[i] = Vs2_vi[i] * Rs1_vi + Vs3_vi[i];
                    }}, OPMVX, VectorMultAccOp);
                    0x2f: vnmsac_vx({{
                        Vd_vi[i] = -(Vs2_vi[i] * Rs1_vi) + Vs3_vi[i];
                    }}, OPMVX, VectorMultAccOp);
                }
                format VectorIntWideningFormat {
                    0x30: vwaddu_vx({{
                        Vd_vwu[i] = vwu(Vs2_vu[i + offset]) + vwu(Rs1_vu);
                    }}, OPMVX, VectorArithOp);
                    0x31: vwadd_vx({{
                        Vd_vwi[i] = vwi(Vs2_vi[i + offset]) + vwi(Rs1_vi);
                    }}, OPMVX, VectorArithOp);
                    0x32: vwsubu_vx({{
                        Vd_vwu[i] = vwu(Vs2_vu[i + offset]) - vwu(Rs1_vu);
                    }}, OPMVX, VectorArithOp);
                    0x33: vwsub_vx({{
                        Vd_vwi[i] = vwi(Vs2_vi[i + offset]) - vwi(Rs1_vi);
                    }}, OPMVX, VectorArithOp);
                    0x34: vwaddu_wx({{
                        Vd_vwu[i] = Vs2_vwu[i] + vwu(Rs1_vu);
                    }}, OPMVX, VectorArithOp);
                    0x35: vwadd_wx({{
                        Vd_vwi[i] = Vs2_vwi[i] + vwi(Rs1_vi);
                    }}, OPMVX, VectorArithOp);
                    0x36: vwsubu_wx({{
                        Vd_vwu[i] = Vs2_vwu[i] - vwu(Rs1_vu);
                    }}, OPMVX, VectorArithOp);
                    0x37: vwsub_wx({{
                        Vd_vwi[i] = Vs2_vwi[i] - vwi(Rs1_vi);
                    }}, OPMVX, VectorArithOp);
                    0x38: vwmulu_vx({{
                        Vd_vwu[i] = vwu(Vs2_vu[i + offset]) * vwu(Rs1_vu);
                    }}, OPMVX, VectorMultOp);
                    0x3a: vwmulsu_vx({{
                        Vd_vwi[i] = vwi(Vs2_vi[i + offset]) * vwu(Rs1_vu);
                    }}, OPMVX, VectorMultOp);
                    0x3b: vwmul_vx({{
                        Vd_vwi[i] = vwi(Vs2_vi[i + offset]) * vwi(Rs1_vi);
                    }}, OPMVX, VectorMultOp);
                    0x3c: vwmaccu_vx({{
                        Vd_vwu[i] = vwu(Rs1_vu) * vwu(Vs2_vu[i + offset])
                                + Vs3_vwu[i];
                    }}, OPMVX, VectorMultAccOp);
                    0x3d: vwmacc_vx({{
                        Vd_vwi[i] = vwi(Rs1_vi) * vwi(Vs2_vi[i + offset])
                                + Vs3_vwi[i];
                    }}, OPMVX, VectorMultAccOp);
                    0x3e: vwmaccus_vx({{
                        Vd_vwi[i] = vwu(Rs1_vu) * vwi(Vs2_vi[i + offset])
                                + Vs3_vwi[i];
                    }}, OPMVX, VectorMultAccOp);
                    0x3f: vwmaccsu_vx({{
                        Vd_vwi[i] = vwi(Rs1_vi) * vwu(Vs2_vu[i + offset])
                                + Vs3_vwi[i];
                    }}, OPMVX, VectorMultAccOp);
                }
            }
            0x7: decode BIT31 {
                format VConfOp {
                    0x0: vsetvli({{
                        uint64_t rd_bits = RD;
                        uint64_t rs1_bits = RS1;
                        uint64_t requested_vl = Rs1_ud;
                        uint64_t requested_vtype = zimm11;

                        Rd_ud = 0;
                    }}, VectorConfigOp);
                    0x1: decode BIT30 {
                        0x0: vsetvl({{
                            uint64_t rd_bits = RD;
                            uint64_t rs1_bits = RS1;
                            uint64_t requested_vl = Rs1_ud;
                            uint64_t requested_vtype = Rs2_ud;
                            uint32_t ignore_this = rVl;

                            Rd_ud = 0;
                        }}, VectorConfigOp);
                        0x1: vsetivli({{
                            uint64_t rd_bits = RD;
                            uint64_t rs1_bits = -1;
                            uint64_t requested_vl = uimm;
                            uint64_t requested_vtype = zimm10;

                            Rd_ud = 0;
                        }}, VectorConfigOp);
                    }
                }
            }
        }
    }
}
