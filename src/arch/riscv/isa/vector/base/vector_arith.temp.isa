    }

    VRM_REQUIRED;

    const int32_t t_micro_vlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    const int32_t micro_vlmax = calcNarrowingMicroVlmax(t_micro_vlmax, vlmul);
    [[maybe_unused]] const size_t offset =
        (this->microIdx % 2) * micro_vlmax;
    uint32_t elem_num_per_vreg = micro_vlmax;

    %(op_decl)s;
    %(op_rd)s;
    adjustNarrowingSrcSlice(Vs2, vlmul, offset);
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    %(code)s;
    %(op_wb)s;
    return NoFault;
}

}};

