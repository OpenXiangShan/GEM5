def template VectorReduceMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s {
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorReduceMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 0.0,      // check_vd, vd is a single reg for reductions
                                             false, 1.0,     // check_vs1, vs1_multiplier
                                             true, 1.0,      // check_vs2, vs2_multiplier
                                             false, 1.0,     // check_vs3, vs3_multiplier
                                             "%(mnemonic)s");

    assert(all_regs_valid);

    // Reductions keep the full micro-op chain to preserve FP accumulation
    // ordering and intermediate state behavior.
    const uint32_t num_microops = (vflmul < 1 ? 1 : (int)vflmul) * VregBanks;

    StaticInstPtr microop;

    for (int i = 0; i < num_microops; ++i) {
        microop = new %(class_name)sMicro<ElemType>(_machInst, i);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }
    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorReduceSequentialFloatMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 0.0,      // check_vd, vd is a single reg for reductions
                                             false, 1.0,     // check_vs1, vs1_multiplier
                                             true, 1.0,      // check_vs2, vs2_multiplier
                                             false, 1.0,     // check_vs3, vs3_multiplier
                                             "%(mnemonic)s");
    assert(all_regs_valid);

    const uint32_t num_slots = (vflmul < 1 ? 1 : (int)vflmul) * VregBanks;

    StaticInstPtr microop;
    uint8_t micro_idx = 0;
    for (uint8_t s = 0; s < num_slots; ++s) {
        microop = new VReduceFPSeqStepMicroInst<ElemType>(
            _machInst, s, %(op_class)s);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
        micro_idx++;
    }

    microop = new VReduceFPSeqFinalMicroInst<ElemType>(
        _machInst, %(op_class)s, micro_idx++);
    microop->setDelayedCommit();
    this->microops.push_back(microop);

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorReduceParallelIntMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 0.0,      // check_vd, vd is a single reg for reductions
                                             false, 1.0,     // check_vs1, vs1_multiplier
                                             true, 1.0,      // check_vs2, vs2_multiplier
                                             false, 1.0,     // check_vs3, vs3_multiplier
                                             "%(mnemonic)s");
    assert(all_regs_valid);

    // FP-like ordering: inter-register first (Leaf), then intra-lane tree,
    // then Final with internal lane reduction + vs1[0] fold.
    const uint32_t reg_slots = (vflmul < 1 ? 1 : (int)vflmul);
    const uint32_t num_slots = reg_slots * VregBanks;
    const uint32_t leaf_slots = num_slots / 2;
    panic_if(leaf_slots > NumVecBufRegs,
             "parallel int reduce leaf slots=%u exceeds NumVecBufRegs=%u",
             leaf_slots, NumVecBufRegs);

    StaticInstPtr microop;
    uint8_t micro_idx = 0;

    // Leaf phase: pair same-bank slots from adjacent register groups.
    if (reg_slots == 1) {
        // LMUL<=1: only one architectural source register; pair its two banks.
        microop = new VReduceIntLeafMicroInst<ElemType>(
            _machInst, 0, 0, 1, true, %(op_class)s, micro_idx++);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    } else {
        // LMUL>1: pair corresponding banks across adjacent register pairs.
        const uint32_t reg_pair_cnt = reg_slots / 2;
        uint8_t d = 0;
        for (uint8_t bank = 0; bank < VregBanks; ++bank) {
            for (uint8_t rp = 0; rp < reg_pair_cnt; ++rp) {
                const uint8_t src_a = (2 * rp) * VregBanks + bank;
                const uint8_t src_b = src_a + VregBanks;
                microop = new VReduceIntLeafMicroInst<ElemType>(
                    _machInst, d++, src_a, src_b, true, %(op_class)s, micro_idx++);
                microop->setDelayedCommit();
                this->microops.push_back(microop);
            }
        }
    }

    // Tree phase: lane-wise combination of multi-lane VecBufs.
    for (uint8_t stride = 1; stride < leaf_slots; stride <<= 1) {
        for (uint8_t s = 0; (s + stride) < leaf_slots; s += (stride << 1)) {
            microop = new VReduceIntParallelTreeMicroInst<ElemType>(
                _machInst, s, s + stride, VectorArithOp, micro_idx++);
            microop->setDelayedCommit();
            this->microops.push_back(microop);
        }
    }

    // Intra-lane tree: reduce VecBuf[0] lanes to a single scalar (Reduction type).
    microop = new VReduceIntIntraLaneMicroInst<ElemType>(
        _machInst, 0, %(op_class)s, micro_idx++);
    microop->setDelayedCommit();
    this->microops.push_back(microop);

    // Final: fold scalar VecBuf[0][0] with vs1[0] and write vd (Arith type).
    microop = new VReduceFinalMicroInst<ElemType>(
        _machInst, 0, VectorArithOp, micro_idx++);
    microop->setDelayedCommit();
    this->microops.push_back(microop);

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorReduceParallelIntWidenMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    using AccType = typename double_width<std::make_unsigned_t<ElemType>>::type;
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 0.0,      // check_vd, vd is a single reg for reductions
                                             false, 1.0,     // check_vs1, vs1_multiplier
                                             true, 1.0,      // check_vs2, vs2_multiplier
                                             false, 1.0,     // check_vs3, vs3_multiplier
                                             "%(mnemonic)s");
    assert(all_regs_valid);

    // Inter-register first: each ScalarLeaf processes two ElemType banks and
    // reduces all their elements into one AccType scalar. Then scalar Tree and
    // Final combine the leaf results.
    const uint32_t reg_slots = (vflmul < 1 ? 1 : (int)vflmul);
    const uint32_t num_slots = reg_slots * VregBanks;
    const uint32_t leaf_slots = num_slots / 2;
    panic_if(leaf_slots > NumVecBufRegs,
             "parallel widening int reduce leaf slots=%u exceeds NumVecBufRegs=%u",
             leaf_slots, NumVecBufRegs);

    StaticInstPtr microop;
    uint8_t micro_idx = 0;

    // ScalarLeaf phase: pair same-bank slots from adjacent register groups.
    if (reg_slots == 1) {
        // LMUL<=1: only one architectural source register; pair its two banks.
        microop = new VReduceIntScalarLeafMicroInst<ElemType, AccType>(
            _machInst, 0, 0, 1, true, %(op_class)s, micro_idx++);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    } else {
        // LMUL>1: pair corresponding banks across adjacent register pairs.
        const uint32_t reg_pair_cnt = reg_slots / 2;
        uint8_t d = 0;
        for (uint8_t bank = 0; bank < VregBanks; ++bank) {
            for (uint8_t rp = 0; rp < reg_pair_cnt; ++rp) {
                const uint8_t src_a = (2 * rp) * VregBanks + bank;
                const uint8_t src_b = src_a + VregBanks;
                microop = new VReduceIntScalarLeafMicroInst<ElemType, AccType>(
                    _machInst, d++, src_a, src_b, true, %(op_class)s, micro_idx++);
                microop->setDelayedCommit();
                this->microops.push_back(microop);
            }
        }
    }

    // Tree phase: scalar combination of leaf AccType results.
    for (uint8_t stride = 1; stride < leaf_slots; stride <<= 1) {
        for (uint8_t s = 0; (s + stride) < leaf_slots; s += (stride << 1)) {
            microop = new VReduceTreeMicroInst<AccType>(
                _machInst, s, s + stride, VectorArithOp, micro_idx++);
            microop->setDelayedCommit();
            this->microops.push_back(microop);
        }
    }

    // Final: fold vs1[0] with the single AccType scalar in VecBuf[0].
    microop = new VReduceFinalMicroInst<AccType>(
        _machInst, 0, VectorArithOp, micro_idx++);
    microop->setDelayedCommit();
    this->microops.push_back(microop);

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorReduceParallelFloatMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 0.0,      // check_vd, vd is a single reg for reductions
                                             false, 1.0,     // check_vs1, vs1_multiplier
                                             true, 1.0,      // check_vs2, vs2_multiplier
                                             false, 1.0,     // check_vs3, vs3_multiplier
                                             "%(mnemonic)s");
    assert(all_regs_valid);

    const uint32_t reg_slots = (vflmul < 1 ? 1 : (int)vflmul);
    const uint32_t num_slots = reg_slots * VregBanks;
    const uint32_t leaf_slots = num_slots / 2;
    panic_if(leaf_slots > NumVecBufRegs,
             "parallel float reduce leaf slots=%u exceeds NumVecBufRegs=%u",
             leaf_slots, NumVecBufRegs);

    StaticInstPtr microop;
    uint8_t micro_idx = 0;
    if (reg_slots == 1) {
        // LMUL<=1: only one architectural source register, pair two banks.
        microop = new VReduceFPParallelLeafMicroInst<ElemType>(
            _machInst, 0, 0, 1, true, %(op_class)s, micro_idx++);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    } else {
        // LMUL>1: first reduce across architectural registers per bank,
        // so ordering follows NEMU step1 (reg-pair first, lane reduction later).
        const uint32_t reg_pair_cnt = reg_slots / 2;
        uint8_t d = 0;
        for (uint8_t bank = 0; bank < VregBanks; ++bank) {
            for (uint8_t rp = 0; rp < reg_pair_cnt; ++rp) {
                const uint8_t src_a = (2 * rp) * VregBanks + bank;
                const uint8_t src_b = src_a + VregBanks;
                microop = new VReduceFPParallelLeafMicroInst<ElemType>(
                    _machInst, d++, src_a, src_b, true, %(op_class)s, micro_idx++);
                microop->setDelayedCommit();
                this->microops.push_back(microop);
            }
        }
    }
    for (uint8_t stride = 1; stride < leaf_slots; stride <<= 1) {
        for (uint8_t s = 0; (s + stride) < leaf_slots; s += (stride << 1)) {
            microop = new VReduceFPParallelTreeMicroInst<ElemType>(
                _machInst, s, s + stride, %(op_class)s, micro_idx++);
            microop->setDelayedCommit();
            this->microops.push_back(microop);
        }
    }
    microop = new VReduceFPParallelFinalMicroInst<ElemType>(
        _machInst, 0, %(op_class)s, micro_idx++);
    microop->setDelayedCommit();
    this->microops.push_back(microop);

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorReduceParallelFloatWidenMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    using AccType = typename double_width<ElemType>::type;
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 0.0,      // check_vd, vd is a single reg for reductions
                                             false, 1.0,     // check_vs1, vs1_multiplier
                                             true, 1.0,      // check_vs2, vs2_multiplier
                                             false, 1.0,     // check_vs3, vs3_multiplier
                                             "%(mnemonic)s");
    assert(all_regs_valid);

    const uint32_t num_slots = (vflmul < 1 ? 1 : (int)vflmul) * VregBanks;
    panic_if(num_slots > NumVecBufRegs,
             "parallel widening float reduce slots=%u exceeds NumVecBufRegs=%u",
             num_slots, NumVecBufRegs);

    StaticInstPtr microop;
    uint8_t micro_idx = 0;
    for (uint8_t s = 0; s < num_slots; ++s) {
        microop = new VReduceFPPartialMicroInst<ElemType, AccType, true>(
            _machInst, s, num_slots, %(op_class)s);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
        micro_idx++;
    }
    for (uint8_t stride = 1; stride < num_slots; stride <<= 1) {
        for (uint8_t s = 0; (s + stride) < num_slots; s += (stride << 1)) {
            microop = new VReduceFPTreeMicroInst<AccType>(
                _machInst, s, s + stride, %(op_class)s, micro_idx++);
            microop->setDelayedCommit();
            this->microops.push_back(microop);
        }
    }
    microop = new VReduceFPFinalMicroInst<AccType>(
        _machInst, 0, %(op_class)s, micro_idx++);
    microop->setDelayedCommit();
    this->microops.push_back(microop);

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorReduceMicroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    // vs2, vs1, vd, vm
    RegId srcRegIdxArr[8];
    RegId destRegIdxArr[1];
public:
    %(class_name)s(ExtMachInst _machInst,
                   uint8_t _microIdx);
    Fault execute(ExecContext* xc, Trace::InstRecord* traceData)const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorReduceMicroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst,
                                         uint8_t _microIdx)
: %(base_class)s("%(mnemonic)s", _machInst,
                 %(op_class)s, _microIdx)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    %(set_dest_reg_idx)s;
    %(set_src_reg_idx)s;
}

}};

def template VectorReduceIntMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    %(type_def)s;
    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    uint32_t microvlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    uint32_t elem_num_per_vreg = microvlmax;
    const uint32_t frac_div = (vlmul < 0) ? (1u << (-vlmul)) : 1u;
    const uint32_t src_slice_offset =
        (vlmul < 0) ? (microvlmax * (this->microIdx % frac_div)) : 0;
    auto reduce_loop =
        [&, this](const auto& f, const auto* _, const auto* vs2) {
            ElemType microop_result =
                this->microIdx != 0 ? old_Vd[0] : Vs1[0];
            for (uint32_t i = 0; i < microvlmax; i++) {
                uint32_t ei = i + microvlmax * this->microIdx;
                if ((ei < rVl) && (this->vm || elem_mask(v0, ei))) {
                    microop_result =
                        f(microop_result, vs2[i + src_slice_offset]);
                } else if (ei >= rVl) {
                    break;
                }
            }
            return microop_result;
        };

    %(code)s;
    %(op_wb)s;
    return NoFault;
}

}};

def template VectorReduceFloatMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    %(type_def)s;
    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    VRM_REQUIRED;

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    uint32_t micro_vlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    if (micro_vlmax * this->microIdx < rVl) {
        // Keep a stable snapshot of current vs2 micro-slice. This prevents
        // in-place vd updates from corrupting vs2 reads when vd/vs2 overlap.
        vreg_t vs2_snapshot_reg;
        xc->getRegOperand(this, 1, &vs2_snapshot_reg);
        auto Vs2_snapshot = vs2_snapshot_reg.as<vu>();

        Vd[0] = this->microIdx != 0 ? old_Vd[0] : Vs1[0];
        const uint32_t frac_div = (vlmul < 0) ? (1u << (-vlmul)) : 1u;
        const uint32_t src_slice_offset =
            (vlmul < 0) ? (micro_vlmax * (this->microIdx % frac_div)) : 0;

        auto reduce_loop =
            [&, this](const auto& f, const auto* _, const auto* /*vs2*/) {
                vu tmp_val = Vd[0];
                // Capture rVl snapshot at the beginning to prevent compiler optimization
                uint32_t vl_snapshot = rVl;
                for (uint32_t i = 0; i < micro_vlmax; i++) {
                    uint32_t ei = i + micro_vlmax * this->microIdx;
                    if ((ei < vl_snapshot) && (this->vm || elem_mask(v0, ei))) {
                        tmp_val = f(tmp_val, Vs2_snapshot[i + src_slice_offset]).v;
                    }
                }
                return tmp_val;
            };
        %(code)s;
    }

    %(op_wb)s;
    return NoFault;
}

}};

def template VectorReduceFloatWideningMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    %(type_def)s;
    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    VRM_REQUIRED;

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    uint32_t micro_vlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    if (micro_vlmax * this->microIdx < rVl) {
        // Keep a stable snapshot of current vs2 micro-slice. This prevents
        // in-place vd updates from corrupting vs2 reads when vd/vs2 overlap.
        vreg_t vs2_snapshot_reg;
        xc->getRegOperand(this, 1, &vs2_snapshot_reg);
        auto Vs2_snapshot = vs2_snapshot_reg.as<vu>();

        Vd[0] = this->microIdx != 0 ? old_Vd[0] : Vs1[0];

        const uint32_t frac_div = (vlmul < 0) ? (1u << (-vlmul)) : 1u;
        const uint32_t src_slice_offset =
            (vlmul < 0) ? (micro_vlmax * (this->microIdx % frac_div)) : 0;
        auto reduce_loop =
            [&, this](const auto& f, const auto* _, const auto* /*vs2*/) {
                vwu tmp_val = Vd[0];
                // Capture rVl snapshot at the beginning to prevent compiler optimization
                uint32_t vl_snapshot = rVl;
                for (uint32_t i = 0; i < micro_vlmax; i++) {
                    uint32_t ei = i + micro_vlmax * this->microIdx;
                    if ((ei < vl_snapshot) && (this->vm || elem_mask(v0, ei))) {
                        tmp_val = f(tmp_val, Vs2_snapshot[i + src_slice_offset]).v;
                    }
                }
                return tmp_val;
            };
        %(code)s;
    }

    %(op_wb)s;
    return NoFault;
}

}};

def template VectorGatherMacroDeclare {{

template<typename ElemType, typename IndexType>
class %(class_name)s : public %(base_class)s{
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorGatherMacroConstructor {{

template<typename ElemType, typename IndexType>
%(class_name)s<ElemType, IndexType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    const uint32_t vd_eewb = sizeof(ElemType);
    const uint32_t vs2_eewb = sizeof(ElemType);
    const uint32_t vs1_eewb = sizeof(IndexType);
    const bool vs1_split = vd_eewb > vs1_eewb;

    // Calculate vs1_emul correctly:
    // For vrgather.vv: vs1 EEW = vd EEW, so vs1_emul = vlmul
    // For vrgatherei16.vv: vs1 EEW = 16, so vs1_emul = log2(16/SEW) + vlmul
    // The formula: vs1_emul = vlmul + log2(vs1_eewb / vd_eewb)
    int8_t vs1_emul_raw = vlmul;
    if (vs1_eewb != vd_eewb) {
        // Calculate log2(vs1_eewb / vd_eewb)
        int8_t eew_ratio_log2 = 0;
        if (vs1_eewb > vd_eewb) {
            uint32_t ratio = vs1_eewb / vd_eewb;
            while (ratio > 1) {
                eew_ratio_log2++;
                ratio >>= 1;
            }
        } else {
            uint32_t ratio = vd_eewb / vs1_eewb;
            while (ratio > 1) {
                eew_ratio_log2--;
                ratio >>= 1;
            }
        }
        vs1_emul_raw = vlmul + eew_ratio_log2;
    }

    // Limit vs1_emul to valid range: -3 to 3 (EMUL: 1/8 to 8)
    const int8_t vs1_emul = std::max<int8_t>(-3, std::min<int8_t>(3, vs1_emul_raw));

    const uint8_t vs2_vregs = vlmul < 0 ? 1 : 1 << vlmul;
    const uint8_t vs1_vregs = vs1_emul < 0 ? 1 : 1 << vs1_emul;
    const uint8_t vd_vregs = vs2_vregs;
    const uint32_t active_data_banks = calculateActiveBanks(vflmul);
    const uint32_t active_compute_banks = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, vd_eewb * 8);
    const float vs1_group_mul = vs1_emul >= 0 ?
        static_cast<float>(1u << vs1_emul) :
        (1.0f / static_cast<float>(1u << (-vs1_emul)));
    const uint32_t active_index_banks = calculateActiveBanksWithKnownVl(
        vs1_group_mul, _machInst, vs1_eewb * 8);

    // 判断是否为vv格式（只有vv格式需要检查vs1寄存器组）
    // vrgather.vv/vrgatherei16.vv: vs1是向量寄存器组（索引数组）
    // vrgather.vx: vs1字段是标量寄存器rs1
    // vrgather.vi: vs1字段是立即数uimm
    std::string mnemonic_str = "%(mnemonic)s";
    bool is_vv_format = (mnemonic_str.length() >= 3 &&
                         mnemonic_str.substr(mnemonic_str.length() - 2) == "vv");

    // Gather指令: vd, vs1(索引), vs2(源数据)
    // 检查vd和vs2寄存器
    bool data_regs_valid = CHECK_VREG_INDICES(_machInst, vd_vregs,
                                            true, 1.0,   // vd检查
                                            false, 1.0,  // vs1不检查
                                            true, 1.0,   // vs2检查
                                            false, 1.0,  // vs3不检查
                                            "%(mnemonic)s");

    // 只在vv格式时检查vs1寄存器组
    // 注意：vrgatherei16.vv的vs1 EEW=16，EMUL=(16/SEW)*LMUL
    // 当SEW < 16时，vs1_vregs可能大于vd_vregs
    bool index_regs_valid = true;
    if (is_vv_format) {
        index_regs_valid = CHECK_VREG_INDICES(_machInst, vs1_vregs,
                                            false, 1.0,  // vd不检查
                                            true, 1.0,   // vs1检查
                                            false, 1.0,  // vs2不检查
                                            false, 1.0,  // vs3不检查
                                            "%(mnemonic)s");
    }

    bool all_regs_valid = data_regs_valid && index_regs_valid;
    assert(all_regs_valid);

    StaticInstPtr microop;

    // Phase 1: Assemble vs2 sub-regs into VBUF via VBufInsert micro-ops
    const RegIndex vbuf_idx = 0;
    for (uint32_t slot = 0; slot < active_data_banks; ++slot) {
        const uint8_t arch = slot / VregBanks;
        const uint8_t bank = slot % VregBanks;
        RegIndex src_vec = (_machInst.vs2 + arch) * VregBanks + bank;
        uint32_t offset = slot * DPLENB;
        int expected_writes = 1;
        microop = new VBufInsertMicroInst(_machInst, vbuf_idx,
                                          src_vec, offset,
                                          expected_writes);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    // Phase 2: GatherCompute micro-ops reading from VBUF
    const uint32_t num_compute = is_vv_format ?
        std::max(active_index_banks, active_compute_banks) :
        active_compute_banks;

    for (uint32_t i = 0; i < num_compute; i++) {
        microop = new %(class_name)sMicro<ElemType, IndexType>(_machInst, i);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorGatherMicroDeclare {{

template<typename ElemType, typename IndexType>
class %(class_name)s : public VectorGatherMicroInst
{
private:
    // vs2 is fetched from VecBufRegClass slots and can consume up to
    // NumVecBufRegs sources, plus scalar/vector index, old vd, vl and mask.
    // +1 index source (vs1/rs1) +1 old vd +1 vl +2 mask regs (v0 lo/hi)
    static constexpr size_t MAX_EXTRA_REGS = 5;
    static constexpr size_t MAX_SRC_REGS = NumVecBufRegs + MAX_EXTRA_REGS;
    static constexpr size_t MAX_DEST_REGS = 1;
    RegId srcRegIdxArr[MAX_SRC_REGS];
    RegId destRegIdxArr[MAX_DEST_REGS];
public:
    %(class_name)s(ExtMachInst _machInst,
                   uint8_t _microIdx);
    Fault execute(ExecContext* xc, Trace::InstRecord* traceData)const override;
};

}};

def template VectorGatherMicroConstructor {{

template<typename ElemType, typename IndexType>
%(class_name)s<ElemType, IndexType>::%(class_name)s(ExtMachInst _machInst,
                                                    uint8_t _microIdx)
: VectorGatherMicroInst("%(mnemonic)s", _machInst,
                        %(op_class)s, _microIdx)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    const uint32_t vd_eewb = sizeof(ElemType);
    const uint32_t vs2_eewb = sizeof(ElemType);
    const uint32_t vs1_eewb = sizeof(IndexType);
    const uint8_t vs2_vregs = vlmul < 0 ? 1 : 1 << vlmul;
    const uint32_t active_vs2_slots = calculateActiveBanks(vflmul);

    // 计算vs1和vd的实际EMUL
    // vrgather.vv: vs1 EEW = vd EEW, vs1_emul = vlmul
    // vrgatherei16: vs1 EEW = 16, vs1_emul = vlmul + log2(16/SEW)
    int8_t vs1_emul_raw = vlmul;
    if (vs1_eewb != vd_eewb) {
        int8_t eew_ratio_log2 = 0;
        if (vs1_eewb > vd_eewb) {
            uint32_t ratio = vs1_eewb / vd_eewb;
            while (ratio > 1) { eew_ratio_log2++; ratio >>= 1; }
        } else {
            uint32_t ratio = vd_eewb / vs1_eewb;
            while (ratio > 1) { eew_ratio_log2--; ratio >>= 1; }
        }
        vs1_emul_raw = vlmul + eew_ratio_log2;
    }
    const int8_t vs1_emul = std::max<int8_t>(-3, std::min<int8_t>(3, vs1_emul_raw));
    const uint8_t vs1_vregs = vs1_emul < 0 ? 1 : 1 << vs1_emul;
    const uint8_t vd_vregs = vs2_vregs;

    const uint16_t vd_elems = DPLENB / vd_eewb;
    const uint16_t vs1_elems = DPLENB / vs1_eewb;
    const uint16_t elem_num_per_vreg = DPLENB / std::max(vd_eewb, vs1_eewb);

    // Unified gather mapping: derive source index chunk from destination element
    // base (ei_base) so mixed LMUL/EEW cases share one mechanism.
    [[maybe_unused]] uint8_t vd_idx;
    [[maybe_unused]] uint8_t vs1_idx;
    const uint8_t frac_div = (vlmul < 0) ? (1 << (-vlmul)) : 1;
    const uint8_t micro_reg_idx = _microIdx / VregBanks;
    const uint8_t vd_bank = (_microIdx / frac_div) % VregBanks;
    [[maybe_unused]] uint8_t vs1_bank = 0;
    const uint8_t frac_subidx = (vlmul < 0) ? (_microIdx % frac_div) : 0;

    if (vd_eewb == vs1_eewb) {
        vd_idx = micro_reg_idx;
    } else if (vd_eewb > vs1_eewb) {
        vd_idx = micro_reg_idx;
    } else {
        vd_idx = micro_reg_idx * vd_vregs / vs1_vregs;
    }

    const uint8_t chunks_per_vd_bank =
        (vs1_vregs > vd_vregs) ? (vs1_vregs / vd_vregs) : 1;
    const uint8_t vs1_subidx =
        (vs1_vregs > vd_vregs) ? (micro_reg_idx % chunks_per_vd_bank) : 0;
    const uint32_t ei_base = vd_idx * (VregBanks * vd_elems) +
                             vd_bank * vd_elems +
                             frac_subidx * elem_num_per_vreg +
                             vs1_subidx * elem_num_per_vreg;
    const uint32_t vs1_chunk = ei_base / vs1_elems;
    vs1_idx = vs1_chunk / VregBanks;
    vs1_bank = vs1_chunk % VregBanks;

    %(set_dest_reg_idx)s;

    const char* mnemonic = "%(mnemonic)s";
    bool is_vv = (strstr(mnemonic, "_vv") != nullptr);
    bool is_vx = (strstr(mnemonic, "_vx") != nullptr);

    if (is_vv) {
        vs1srcIdx = _numSrcRegs;
        setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass,
            (_machInst.vs1 + vs1_idx) * VregBanks + vs1_bank));
    } else if (is_vx) {
        vs1srcIdx = _numSrcRegs;
        setSrcRegIdx(_numSrcRegs++, RegId(IntRegClass, _machInst.rs1));
    }

    vs2srcIdx = _numSrcRegs;
    for (uint32_t i = 0; i < active_vs2_slots; i++) {
        setSrcRegIdx(_numSrcRegs++, RegId(VecBufRegClass, i));
    }

    SET_OLDDST_SRC();
    SET_VL_SRC();
    SET_VM_SRC();

    panic_if(_numSrcRegs > MAX_SRC_REGS,
             "VectorGatherMicroInst: Total source registers (%d) exceed "
             "array size (%d)!",
             _numSrcRegs, MAX_SRC_REGS);
    panic_if(_numDestRegs > MAX_DEST_REGS,
             "VectorGatherMicroInst: Total destination registers (%d) exceed "
             "array size (%d)!",
             _numDestRegs, MAX_DEST_REGS);

    setGatherParams(vs2_vregs, vs1_idx, vd_idx);
}

}};

def template VectorGatherMicroExecute {{

template <typename ElemType, typename IndexType>
Fault
%(class_name)s<ElemType, IndexType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    const uint32_t vlmax = calculateVlmax(VLEN, sew, vflmul);
    const uint8_t vd_eewb = sizeof(ElemType);
    const uint8_t vs1_eewb = sizeof(IndexType);
    const uint8_t vs2_eewb = sizeof(ElemType);
    [[maybe_unused]] const uint16_t vd_elems = DPLENB / vd_eewb;
    [[maybe_unused]] const uint16_t vs1_elems = DPLENB / vs1_eewb;
    [[maybe_unused]] const uint16_t vs2_elems = DPLENB / vs2_eewb;
    [[maybe_unused]] const uint8_t vs2_vregs = vlmul < 0 ? 1 : 1 << vlmul;

    // 计算vs1的实际EMUL
    int8_t vs1_emul_raw = vlmul;
    if (vs1_eewb != vd_eewb) {
        int8_t eew_ratio_log2 = 0;
        if (vs1_eewb > vd_eewb) {
            uint32_t ratio = vs1_eewb / vd_eewb;
            while (ratio > 1) { eew_ratio_log2++; ratio >>= 1; }
        } else {
            uint32_t ratio = vd_eewb / vs1_eewb;
            while (ratio > 1) { eew_ratio_log2--; ratio >>= 1; }
        }
        vs1_emul_raw = vlmul + eew_ratio_log2;
    }
    const int8_t vs1_emul = std::max<int8_t>(-3, std::min<int8_t>(3, vs1_emul_raw));
    [[maybe_unused]] const uint8_t vs1_vregs = vs1_emul < 0 ? 1 : 1 << vs1_emul;
    [[maybe_unused]] const uint8_t vd_vregs = vs2_vregs;

    // vd_idx和vs1_idx的计算（与构造函数保持一致）
    [[maybe_unused]] uint8_t vd_idx;
    [[maybe_unused]] uint8_t vs1_idx;
    const uint8_t micro_reg_idx = microIdx / VregBanks;
    if (vd_eewb == vs1_eewb) {
        vd_idx = micro_reg_idx;
        vs1_idx = micro_reg_idx;
    } else if (vd_eewb > vs1_eewb) {
        vd_idx = micro_reg_idx;
        vs1_idx = micro_reg_idx * vs1_vregs / vd_vregs;
    } else {
        vd_idx = micro_reg_idx * vd_vregs / vs1_vregs;
        vs1_idx = micro_reg_idx;
    }

    uint32_t elem_num_per_vreg = DPLENB / std::max(vd_eewb, vs1_eewb);

    alignas(16) uint8_t vbuf_bytes[VLENB * 8] = {0};
    const uint8_t vs2_slots = vs2_vregs * VregBanks;
    for (uint8_t i = 0; i < vs2_slots; i++) {
        RiscvISA::VecBufRegContainer vbuf_slot;
        xc->getRegOperand(this, vs2srcIdx + i, &vbuf_slot);
        memcpy(vbuf_bytes + i * DPLENB, vbuf_slot.as<uint8_t>(), DPLENB);
    }
    vu* Vs2_full = (vu*)vbuf_bytes;

    %(code)s;
    %(op_wb)s;

    return NoFault;
}

}};

def template VectorGatherDecodeBlock {{
{
    const float vflmul = getVflmul(machInst.vtype8.vlmul);
    if (!check_vreg_group_valid(machInst.vd, vflmul, %(vd_multiplier)s) ||
        !check_vreg_group_valid(machInst.vs1, vflmul, %(vs1_multiplier)s) ||
        !check_vreg_group_valid(machInst.vs2, vflmul, %(vs2_multiplier)s)) {
        return new Unknown(machInst);
    }

    switch(machInst.vtype8.vsew) {
    case 0b000: {
        using elem_type [[maybe_unused]] = uint8_t;
        return new %(class_name)s<uint8_t, %(idx_type)s>(machInst);
    }
    case 0b001: {
        using elem_type [[maybe_unused]] = uint16_t;
        return new %(class_name)s<uint16_t, %(idx_type)s>(machInst);
    }
    case 0b010: {
        using elem_type [[maybe_unused]] = uint32_t;
        return new %(class_name)s<uint32_t, %(idx_type)s>(machInst);
    }
    case 0b011: {
        using elem_type [[maybe_unused]] = uint64_t;
        return new %(class_name)s<uint64_t, %(idx_type)s>(machInst);
    }
    default: GEM5_UNREACHABLE;
    }
}
}};

def template VectorIntVxsatMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s{
private:
    %(reg_idx_arr_decl)s;
    bool vxsat = false;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntVxsatMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    CHECK_AND_HANDLE_INVALID_REGS_WITH_VXSAT(%(class_name)s, _machInst, vflmul,
                                  true, 1.0,   // check_vd, vd_multiplier
                                  true, 1.0,   // check_vs1_for_vv, vs1_multiplier
                                  true, 1.0,   // check_vs2, vs2_multiplier
                                  false, 1.0,  // check_vs3, vs3_multiplier
                                  "%(mnemonic)s", ElemType);

    const uint32_t num_microops = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, sew);
    StaticInstPtr microop;

    for (uint32_t i = 0; i < num_microops; ++i) {
        microop = new %(class_name)sMicro<ElemType>(_machInst, i, &vxsat);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }
    microop = new VxsatMicroInst(&vxsat, _machInst);
    microop->setFlag(StaticInst::IsSerializeAfter);
    microop->setFlag(StaticInst::IsNonSpeculative);
    this->microops.push_back(microop);

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

def template VectorIntVxsatMicroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    RegId srcRegIdxArr[8];
    RegId destRegIdxArr[1];
    bool* vxsatptr = nullptr;
public:
    %(class_name)s(ExtMachInst _machInst, uint8_t _microIdx, bool* satptr);
    Fault execute(ExecContext* xc, Trace::InstRecord* traceData)const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntVxsatMicroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst,
    uint8_t _microIdx, bool* satptr)
    : %(base_class)s("%(mnemonic)s", _machInst,
                     %(op_class)s, _microIdx)
{
    vxsatptr = satptr;
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    %(set_dest_reg_idx)s;
    %(set_src_reg_idx)s;
}

}};

def template VectorReduceIntWideningMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;
    using vwu [[maybe_unused]] = typename double_width<vu>::type;
    using vwi [[maybe_unused]] = typename double_width<vi>::type;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    uint32_t micro_vlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    if (micro_vlmax * this->microIdx < rVl) {

        Vd[0] = this->microIdx != 0 ? old_Vd[0] : Vs1[0];
        const uint32_t frac_div = (vlmul < 0) ? (1u << (-vlmul)) : 1u;
        const uint32_t src_slice_offset =
            (vlmul < 0) ? (micro_vlmax * (this->microIdx % frac_div)) : 0;
        auto reduce_loop =
            [&, this](const auto& f, const auto* _, const auto* vs2) {
                vwu tmp_val = Vd[0];
                for (uint32_t i = 0; i < micro_vlmax; i++) {
                    uint32_t ei = i + micro_vlmax * this->microIdx;
                    if ((ei < rVl) && (this->vm || elem_mask(v0, ei))) {
                        tmp_val = f(tmp_val, vs2[i + src_slice_offset]);
                    }
                }
                return tmp_val;
            };

        %(code)s;
    }

    %(op_wb)s;
    return NoFault;
}

}};

def template VectorSlideMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s {
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorSlideUpMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    bool all_regs_valid = CHECK_VREG_INDICES(_machInst, vflmul,
                                             true, 1.0,
                                             false, 1.0,
                                             true, 1.0,
                                             false, 1.0,
                                             "%(mnemonic)s");

    assert(all_regs_valid);

    const uint32_t elem_num_per_vreg = VLEN / sew;
    const uint32_t elem_num_per_phy_reg = elem_num_per_vreg / VregBanks;
    const uint32_t num_insert_microops = calculateActiveBanks(vflmul);
    const uint32_t num_compute_microops = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, sew);
    StaticInstPtr microop;

    const RegIndex vbuf_idx = 0;
    for (uint32_t slot = 0; slot < num_insert_microops; ++slot) {
        const uint32_t arch = slot / VregBanks;
        const uint32_t bank = slot % VregBanks;
        RegIndex src = (_machInst.vs2 + arch) * VregBanks + bank;
        uint32_t offset = slot * DPLENB;
        int expected_writes = 1;
        microop = new VBufInsertMicroInst(_machInst, vbuf_idx, src, offset,
                                          expected_writes);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    int micro_idx = 0;
    VectorMicroInfo vmi;
    for (uint32_t i = 0; i < num_compute_microops; ++i) {
        const uint32_t arch_vreg = i / VregBanks;
        const uint32_t bank = i % VregBanks;
        vmi.rs = i * elem_num_per_phy_reg;
        vmi.re = (i+1) * elem_num_per_phy_reg;
        vmi.microVd = (VD + arch_vreg) * VregBanks + bank;
        vmi.microVs2 = 0;
        microop = new %(class_name)sMicro<ElemType>(_machInst, micro_idx++, vmi);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

