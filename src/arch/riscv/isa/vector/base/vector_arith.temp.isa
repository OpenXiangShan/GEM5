def template VectorIntWideningMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;
    using vwu [[maybe_unused]] = typename double_width<vu>::type;
    using vwi [[maybe_unused]] = typename double_width<vi>::type;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    const int32_t t_micro_vlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    // For mf8/mf4, we use one destination-bank micro-op, so each micro-op must
    // cover both halves that used to be split by offset.
    const int32_t micro_vlmax = calcWideningMicroVlmax(t_micro_vlmax, vlmul);
    [[maybe_unused]] const size_t offset =
        (this->microIdx % 2) * micro_vlmax;
    uint32_t elem_num_per_vreg = micro_vlmax;

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    %(code)s;
    %(op_wb)s;
    return NoFault;
}

}};

def template VectorIntNarrowingMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;
    using vwu [[maybe_unused]] = typename double_width<vu>::type;
    using vwi [[maybe_unused]] = typename double_width<vi>::type;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }
    const int32_t t_micro_vlmax = DPLEN / sew * (vflmul >= 1 ? 1 : vflmul);
    const int32_t micro_vlmax = calcNarrowingMicroVlmax(t_micro_vlmax, vlmul);
    [[maybe_unused]] const size_t offset =
        (this->microIdx % 2) * micro_vlmax;
    uint32_t elem_num_per_vreg = micro_vlmax;

    %(op_decl)s;
    %(op_rd)s;
    adjustNarrowingSrcSlice(Vs2, vlmul, offset);
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    // Accumulate saturation flags from all micro-ops using shared pointer
    // This preserves saturation information across all micro-ops
    bool any_saturated = false;

    %(code)s;

    // Accumulate the saturation flag from this micro-op to the shared vxsat
    if (vxsatptr) {
        *vxsatptr |= any_saturated;
    }

    %(op_wb)s;
    return NoFault;
}

}};

