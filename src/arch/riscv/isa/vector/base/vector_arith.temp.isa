def template VectorMaskMicroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst,
                                         uint8_t _microIdx)
    : VectorArithMicroInst("%(mnemonic)s_micro", _machInst, %(op_class)s, _microIdx)
{
    %(set_reg_idx_arr)s;
