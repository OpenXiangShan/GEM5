def template ViotaMicroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint8_t _microIdx, VectorMicroInfo& _vmi)
    : %(base_class)s("%(mnemonic)s", _machInst,
                     %(op_class)s, _microIdx)
{
    %(set_reg_idx_arr)s;
    vmi = _vmi;
    assert(~vmi.microVd);
    _numDestRegs = 0;
    _numSrcRegs = 0;
    setDestRegIdx(_numDestRegs++, RegId(VecRegClass, vmi.microVd));
    _numTypedDestRegs[VecRegClass]++;
    setDestRegIdx(_numDestRegs++, RegId(VecBufRegClass, 0)); // has_one cnt
    _numTypedDestRegs[VecBufRegClass]++;

    setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass, vmi.microVs2));
    SET_OLDDST_SRC();
    SET_VL_SRC();
    if (_microIdx != 0) {
        setSrcRegIdx(_numSrcRegs++, RegId(VecBufRegClass, 0));
    }
    SET_VM_SRC();

}

}};

