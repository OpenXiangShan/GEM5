def template VectorIntMaskMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s {
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntMaskMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    CHECK_AND_HANDLE_INVALID_REGS(%(class_name)s, _machInst, vflmul,
                                  true, 0.0,   // check_vd, vd_multiplier (mask dest is a single mask register)
                                  true, 1.0,   // check_vs1_for_vv, vs1_multiplier
                                  true, 1.0,   // check_vs2, vs2_multiplier
                                  false, 1.0,  // check_vs3, vs3_multiplier
                                  "%(mnemonic)s", ElemType);

    const uint32_t num_microops = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, sew);
    const uint32_t bit_offset = DPLENB / sizeof(ElemType);
    const uint32_t total_mask_bits = num_microops * bit_offset;
    const uint32_t packed_slots = ceilDiv(total_mask_bits, (uint32_t)DPLEN);
    const uint32_t micros_per_slot = DPLEN / bit_offset;
    StaticInstPtr microop;

    for (uint32_t i = 0; i < num_microops; ++i) {
        const uint32_t packed_bit_base = i * bit_offset;
        const uint8_t packed_slot = packed_bit_base / DPLEN;
        const uint16_t slot_bit_base = packed_bit_base % DPLEN;
        const uint32_t slot_first_micro = packed_slot * micros_per_slot;
        const uint8_t expected_writes =
            std::min<uint32_t>(micros_per_slot, num_microops - slot_first_micro);
        microop = new %(class_name)sMicro<ElemType>(
            _machInst, i, packed_slot, slot_bit_base, expected_writes);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    for (uint32_t slot = 0; slot < packed_slots; ++slot) {
        VectorMicroInfo merge_vmi;
        merge_vmi.rs = slot * DPLEN;
        merge_vmi.re = std::min<uint32_t>(total_mask_bits,
                                          (slot + 1) * DPLEN);
        merge_vmi.fn = 0;
        merge_vmi.microVd = _machInst.vd * VregBanks + slot;
        microop = new BitMaskMergeMicroInst(
            _machInst, merge_vmi, slot, %(mask_cond)s);
        microop->setNF(1);
        if (slot != packed_slots - 1) {
            microop->setDelayedCommit();
        }
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

