def template VectorMaskMicroExecute {{

template<typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu = uint8_t;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    %(op_decl)s;
    %(op_rd)s;
    uint64_t vl = 0;
    assert(vlsrcIdx > 0);
    vl = xc->getRegOperand(this, vlsrcIdx);
    uint32_t elem_num_per_vreg = DPLEN;
    COPY_OLD_VD();

    for (uint32_t i = 0; i < elem_num_per_vreg; i++) {
        uint32_t ei = i + this->microIdx * DPLEN;
        if (ei < vl) {
            %(code)s;
        }
    }
    if (RVV_AGNOSTIC && vl > 0) {
        for (uint32_t i = 0; i < elem_num_per_vreg; i++) {
            uint32_t ei = i + this->microIdx * DPLEN;
            if (ei >= vl && ei < VLEN) {
                Vd[i/8] = ASSIGN_VD_BIT(i, 1);
            }
        }
    }
    %(op_wb)s;

    return NoFault;
};

}};

def template VectorMaskExecute {{

template<typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu = uint8_t;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    %(op_decl)s;
    %(op_rd)s;
    COPY_OLD_VD();

    %(code)s;
    if (RVV_AGNOSTIC && rVl > 0) {
        for (uint32_t ei = rVl; ei < DPLEN; ei++) {
            Vd[ei/8] = ASSIGN_VD_BIT(ei, 1);
        }
    }
    %(op_wb)s;

    return NoFault;
};

}};

def template VectorMaskDecodeBlock {{
{
    const float vflmul = getVflmul(machInst.vtype8.vlmul);
    if (!check_vreg_group_valid(machInst.vd, vflmul, %(vd_multiplier)s) ||
        !check_vreg_group_valid(machInst.vs1, vflmul, %(vs1_multiplier)s) ||
        !check_vreg_group_valid(machInst.vs2, vflmul, %(vs2_multiplier)s)) {
        return new Unknown(machInst);
    }
    return new %(class_name)s<uint8_t>(machInst);
}
}};

