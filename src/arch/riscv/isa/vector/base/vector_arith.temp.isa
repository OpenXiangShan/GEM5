def template VectorIntMaskMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;
    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;

    // Packed compare results are accumulated into a shared vbuf slot.
    const uint16_t offset = packedBitBase;
    uint32_t elem_num_per_vreg = calcMaskElemPerMicro(sew);

    %(code)s;
    // Tail policy is handled in merge micro-op to avoid cross-bank corruption.
    %(op_wb)s;
    return NoFault;
}

}};

