output header {{

#define ASSIGN_VD_BIT(idx, bit) \
    ((Vd[(idx)/8] & ~(1 << (idx)%8)) | ((bit) << (idx)%8))

#define COPY_OLD_VD() \
    [[maybe_unused]] RiscvISA::vreg_t old_vd; \
    [[maybe_unused]] decltype(Vd) old_Vd = nullptr; \
    assert(oldDstIdx > 0); \
    xc->getRegOperand(this, oldDstIdx, &old_vd); \
    old_Vd = old_vd.as<std::remove_reference_t<decltype(Vd[0])> >(); \
    memcpy(Vd, old_Vd, DPLENB);

#define SET_OLDDST_SRC() \
    oldDstIdx = _numSrcRegs; \
    setSrcRegIdx(_numSrcRegs++, destRegIdxArr[0]);

#define SET_VL_SRC() \
    vlsrcIdx = _numSrcRegs; \
    setSrcRegIdx(_numSrcRegs++, VecRenamedVLReg);

#define SET_VTYPE_SRC() \
    vtypesrcIdx = _numSrcRegs; \
    setSrcRegIdx(_numSrcRegs++, VecRenamedVTYPEReg);

#define SET_VSTART_SRC() \
    vstartsrcIdx = _numSrcRegs; \
    setSrcRegIdx(_numSrcRegs++, VecRenamedVSTARTReg);

#define SET_VM_SRC() \
    if (!this->vm) { \
        vmsrcIdx = _numSrcRegs; \
        for (uint32_t _b = 0; _b < RiscvISA::VregBanks; ++_b) { \
            setSrcRegIdx(_numSrcRegs++, RegId(VecRegClass, _b)); \
        } \
    }

#define VM_REQUIRED() \
    uint8_t tmp_v0_storage[VLENB]; \
    uint8_t *v0; \
    if(!this->vm) { \
        assert(vmsrcIdx > 0); \
        for (uint32_t _b = 0; _b < RiscvISA::VregBanks; ++_b) { \
            RiscvISA::vreg_t v0_bank; \
            xc->getRegOperand(this, vmsrcIdx + _b, &v0_bank); \
            memcpy(tmp_v0_storage + _b * DPLENB, &v0_bank, DPLENB); \
        } \
        v0 = tmp_v0_storage; \
    }

#define VRM_REQUIRED                                                         \
        uint_fast8_t frm = xc->readMiscReg(MISCREG_FRM);                     \
        if (frm > 4)                                                         \
            return std::make_shared<IllegalInstFault>("RM fault", machInst); \
        softfloat_roundingMode = frm;

template<typename Type>
bool inline
carry_out(Type a, Type b, bool carry_in = false) {
    using TypeU = std::make_unsigned_t<Type>;
    TypeU s = *reinterpret_cast<TypeU*>(&a)
            + *reinterpret_cast<TypeU*>(&b) + carry_in;
    return carry_in
        ? (s <= *reinterpret_cast<TypeU*>(&a))
        : (s <  *reinterpret_cast<TypeU*>(&a));
}

template<typename Type>
bool inline
borrow_out(Type a, Type b, bool borrow_in = false) {
    using TypeU = std::make_unsigned_t<Type>;
    return borrow_in
        ? (*reinterpret_cast<TypeU*>(&a) <= *reinterpret_cast<TypeU*>(&b))
        : (*reinterpret_cast<TypeU*>(&a) <  *reinterpret_cast<TypeU*>(&b));
}

// 检查向量寄存器索引是否有效

// reg_idx: 寄存器基础索引
// check_alignment: 是否检查对齐（LMUL>1时需要对齐）
inline bool
check_vreg_idx_valid(uint32_t reg_idx, uint32_t num_regs,
                     bool check_alignment = true) {
    if (reg_idx + num_regs > 32) {
        return false;
    }

    // 检查LMUL对齐要求
    if (check_alignment && num_regs > 1) {
        // 计算对齐要求：向上取到最近的2的幂次
        uint32_t alignment = 1;
        while (alignment < num_regs) {
            alignment <<= 1;
        }
        // 寄存器索引必须是alignment的倍数
        if (reg_idx % alignment != 0) {
            return false;
        }
    }

    return true;
}


// Decode-time register group validation helper.
// multiplier <= 0 means skip check (e.g., reduce vd is a single register).
inline bool
check_vreg_group_valid(uint32_t reg_idx, float vflmul, float multiplier) {
    if (multiplier <= 0) return true;
    uint32_t num_regs = std::max<uint32_t>(1, (uint32_t)(vflmul * multiplier));
    return num_regs <= 8 && check_vreg_idx_valid(reg_idx, num_regs);
}

// Split/mapping helpers are lane-count agnostic: VregBanks can scale to N lanes.
// Keep the lane granularity assumption explicit for readability/review.
[[maybe_unused]] constexpr uint32_t kMinLaneGranularityBits = 64;

inline int32_t
calcWideningMicroVlmax(int32_t t_micro_vlmax, int32_t vlmul)
{
    // For mf8/mf4 widening, one destination bank micro-op must cover both
    // halves that used to be separated by offset.
    return (vlmul < -1) ? (t_micro_vlmax * 2) :
           ((vlmul < 0) ? t_micro_vlmax : (t_micro_vlmax / 2));
}

inline int32_t
calcNarrowingMicroVlmax(int32_t t_micro_vlmax, int32_t vlmul)
{
    return (vlmul < 0) ? t_micro_vlmax : (t_micro_vlmax / 2);
}

template<typename ElemPtr>
inline void
adjustNarrowingSrcSlice(ElemPtr &src, int32_t vlmul, size_t offset)
{
    // For mf8/mf4 narrowing, paired micro-ops share one source bank.
    if (vlmul < -1) {
        src += offset;
    }
}

inline uint32_t
calcMaskElemPerMicro(int sew_bits)
{
    return DPLEN / sew_bits;
}

template<typename MaskBitsPtr, typename OldMaskBitsPtr>
inline void
remapMaskOldVdBits(MaskBitsPtr dst_mask, OldMaskBitsPtr old_mask,
                   uint32_t elem_num_per_micro, uint32_t micro_idx)
{
    for (uint32_t i = 0; i < elem_num_per_micro; i++) {
        uint32_t ei = i + elem_num_per_micro * micro_idx;
        const uint8_t bit = elem_mask(old_mask, ei);
        dst_mask[i / 8] =
            ((dst_mask[i / 8] & ~(1 << (i % 8))) | (bit << (i % 8)));
    }
}

// 通用的向量指令寄存器检查宏
// 用于在Macro构造函数中检查所有寄存器索引的有效性
// 参数：
//   machInst: ExtMachInst对象
//   reg_mul: 使用vreg数量（基础LMUL）
//   check_vd: 是否检查目标寄存器vd
//   vd_multiplier: vd寄存器数量倍数（普通指令=1，宽化指令=2）
//   check_vs1: 是否检查源寄存器vs1
//   vs1_multiplier: vs1寄存器数量倍数
//   check_vs2: 是否检查源寄存器vs2
//   vs2_multiplier: vs2寄存器数量倍数（普通指令=1，窄化指令=2）
//   check_vs3: 是否检查源寄存器vs3
//   vs3_multiplier: vs3寄存器数量倍数
//   mnemonic: 指令助记符（用于警告信息）
// 返回：如果所有寄存器都有效返回true，否则返回false
// 辅助宏：检查单个向量寄存器的有效性
#define CHECK_SINGLE_VREG(machInst, reg_field, reg_name, reg_type, \
                          reg_mul, multiplier, mnemonic, all_valid_flag) \
do { \
    uint32_t num_regs = std::max<uint32_t>((uint32_t)(reg_mul * multiplier), 1); \
    if (!check_vreg_idx_valid(machInst.reg_field, num_regs, true)) { \
        warn("Vector instruction %s: Invalid %s register %s=%d, " \
             "num_regs=%d (base=%d, multiplier=%.1f)", \
             mnemonic, reg_type, reg_name, \
             (uint32_t)machInst.reg_field, num_regs, \
             reg_mul, multiplier); \
        all_valid_flag = false; \
    } \
} while(0)

// 主宏：检查所有向量寄存器索引的有效性
#define CHECK_VREG_INDICES(machInst, reg_mul, \
                           check_vd, vd_multiplier, \
                           check_vs1, vs1_multiplier, \
                           check_vs2, vs2_multiplier, \
                           check_vs3, vs3_multiplier, \
                           mnemonic) \
({ \
    bool all_valid = true; \
    if (check_vd) { \
        CHECK_SINGLE_VREG(machInst, vd, "vd", "destination", \
                          reg_mul, vd_multiplier, mnemonic, all_valid); \
    } \
    if (all_valid && check_vs1) { \
        CHECK_SINGLE_VREG(machInst, vs1, "vs1", "source", \
                          reg_mul, vs1_multiplier, mnemonic, all_valid); \
    } \
    if (all_valid && check_vs2) { \
        CHECK_SINGLE_VREG(machInst, vs2, "vs2", "source", \
                          reg_mul, vs2_multiplier, mnemonic, all_valid); \
    } \
    if (all_valid && check_vs3) { \
        CHECK_SINGLE_VREG(machInst, vs3, "vs3", "source", \
                          reg_mul, vs3_multiplier, mnemonic, all_valid); \
    } \
    all_valid; \
})

// 专门用于segment指令的寄存器检查宏
// 对于segment指令，对齐约束仅基于EMUL，而不是EMUL*nf
// 参数：
//   machInst: ExtMachInst对象
//   emul: 每个field的EMUL值
//   nf: segment字段数
//   check_vd: 是否检查目标寄存器vd (用于load指令)
//   check_vs3: 是否检查源寄存器vs3 (用于store指令)
//   mnemonic: 指令助记符（用于警告信息）
// 返回：如果所有寄存器都有效返回true，否则返回false
#define CHECK_SEGMENT_VREG_INDICES(machInst, emul, nf, check_vd, check_vs3, mnemonic) \
({ \
    bool all_valid = true; \
    uint32_t reg_idx = check_vd ? machInst.vd : machInst.vs3; \
    const char* reg_name = check_vd ? "vd" : "vs3"; \
    const char* reg_type = check_vd ? "destination" : "source"; \
    \
    /* 检查1: 所有field的寄存器不能超过31 */ \
    uint32_t total_regs = emul * nf; \
    if (reg_idx + total_regs > 32) { \
        warn("Vector instruction %s: Invalid %s register %s=%d, " \
             "total_regs=%d (emul=%d, nf=%d) - exceeds register file", \
             mnemonic, reg_type, reg_name, reg_idx, total_regs, emul, nf); \
        all_valid = false; \
    } \
    \
    /* 检查2: 如果EMUL>1，每个field的起始寄存器必须对齐 */ \
    if (all_valid && emul > 1) { \
        uint32_t alignment = 1; \
        while (alignment < emul) { \
            alignment <<= 1; \
        } \
        /* 检查每个field的起始寄存器 */ \
        for (uint32_t i = 0; i < nf; i++) { \
            uint32_t field_start = reg_idx + i * emul; \
            if (field_start % alignment != 0) { \
                warn("Vector instruction %s: Invalid %s register " \
                     "%s=%d, field %d starts at v%d which is not aligned " \
                     "to %d (emul=%d)", \
                     mnemonic, reg_type, reg_name, reg_idx, i, field_start, alignment, emul); \
                all_valid = false; \
                break; \
            } \
        } \
    } \
    all_valid; \
})
// 高层宏：检查寄存器索引（非法编码应在decode阶段拦截）
// 参数：
//   class_name: 指令类名（保留用于宏调用一致性）
//   machInst: ExtMachInst对象
//   reg_mul: 使用vreg数量
//   check_vd: 是否检查vd
//   vd_multiplier: vd寄存器倍数
//   check_vs1_for_vv: 是否仅在VV格式时检查vs1（true表示根据指令格式判断）
//   vs1_multiplier: vs1寄存器倍数
//   check_vs2: 是否检查vs2
//   vs2_multiplier: vs2寄存器倍数
//   check_vs3: 是否检查vs3
//   vs3_multiplier: vs3寄存器倍数
//   mnemonic: 指令助记符
// 如果检查失败，在构造阶段仅做assert（非法编码应在decode阶段拦截）
// 模板版本的宏，用于大多数指令
#define CHECK_AND_HANDLE_INVALID_REGS(class_name, machInst, reg_mul, \
                                      check_vd, vd_multiplier, \
                                      check_vs1_for_vv, vs1_multiplier, \
                                      check_vs2, vs2_multiplier, \
                                      check_vs3, vs3_multiplier, \
                                      mnemonic, ElemType) \
do { \
    std::string mnemonic_str = mnemonic; \
    bool is_vv_format = (mnemonic_str.length() >= 3 && \
                         mnemonic_str.substr(mnemonic_str.length() - 2) == "vv"); \
    bool check_vs1 = check_vs1_for_vv ? is_vv_format : check_vs1_for_vv; \
    \
    bool all_regs_valid = CHECK_VREG_INDICES(machInst, reg_mul, \
                                             check_vd, vd_multiplier, \
                                             check_vs1, vs1_multiplier, \
                                             check_vs2, vs2_multiplier, \
                                             check_vs3, vs3_multiplier, \
                                             mnemonic); \
    assert(all_regs_valid); \
} while(0)

// 专门用于VectorIntFormat的CHECK宏（使用VMI）
#define CHECK_AND_HANDLE_INVALID_REGS_WITH_VMI(class_name, machInst, reg_mul, \
                                      check_vd, vd_multiplier, \
                                      check_vs1_for_vv, vs1_multiplier, \
                                      check_vs2, vs2_multiplier, \
                                      check_vs3, vs3_multiplier, \
                                      mnemonic, ElemType) \
do { \
    std::string mnemonic_str = mnemonic; \
    bool is_vv_format = (mnemonic_str.length() >= 3 && \
                         mnemonic_str.substr(mnemonic_str.length() - 2) == "vv"); \
    bool check_vs1 = check_vs1_for_vv ? is_vv_format : check_vs1_for_vv; \
    bool all_regs_valid = CHECK_VREG_INDICES(machInst, reg_mul, \
                                             check_vd, vd_multiplier, \
                                             check_vs1, vs1_multiplier, \
                                             check_vs2, vs2_multiplier, \
                                             check_vs3, vs3_multiplier, \
                                             mnemonic); \
    assert(all_regs_valid); \
} while(0)

// 非模板版本的宏，用于vmv*r_v指令
#define CHECK_AND_HANDLE_INVALID_REGS_NONTEMPLATE(class_name, machInst, reg_mul, \
                                      check_vd, vd_multiplier, \
                                      check_vs1_for_vv, vs1_multiplier, \
                                      check_vs2, vs2_multiplier, \
                                      check_vs3, vs3_multiplier, \
                                      mnemonic) \
do { \
    std::string mnemonic_str = mnemonic; \
    bool is_vv_format = (mnemonic_str.length() >= 3 && \
                         mnemonic_str.substr(mnemonic_str.length() - 2) == "vv"); \
    bool check_vs1 = check_vs1_for_vv ? is_vv_format : check_vs1_for_vv; \
    bool all_regs_valid = CHECK_VREG_INDICES(machInst, reg_mul, \
                                             check_vd, vd_multiplier, \
                                             check_vs1, vs1_multiplier, \
                                             check_vs2, vs2_multiplier, \
                                             check_vs3, vs3_multiplier, \
                                             mnemonic); \
    assert(all_regs_valid); \
} while(0)

// 带vxsat上下文的版本（同样只做assert）
#define CHECK_AND_HANDLE_INVALID_REGS_WITH_VXSAT(class_name, machInst, reg_mul, \
                                      check_vd, vd_multiplier, \
                                      check_vs1_for_vv, vs1_multiplier, \
                                      check_vs2, vs2_multiplier, \
                                      check_vs3, vs3_multiplier, \
                                      mnemonic, ElemType) \
do { \
    std::string mnemonic_str = mnemonic; \
    bool is_vv_format = (mnemonic_str.length() >= 3 && \
                         mnemonic_str.substr(mnemonic_str.length() - 2) == "vv"); \
    bool check_vs1 = check_vs1_for_vv ? is_vv_format : check_vs1_for_vv; \
    bool all_regs_valid = CHECK_VREG_INDICES(machInst, reg_mul, \
                                             check_vd, vd_multiplier, \
                                             check_vs1, vs1_multiplier, \
                                             check_vs2, vs2_multiplier, \
                                             check_vs3, vs3_multiplier, \
                                             mnemonic); \
    assert(all_regs_valid); \
} while(0)




}};


def template VectorIntMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s {
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    CHECK_AND_HANDLE_INVALID_REGS(%(class_name)s, _machInst, vflmul,
                                  true, 0.0,   // check_vd, vd_multiplier (mask dest is a single mask register)
                                  true, 1.0,   // check_vs1_for_vv, vs1_multiplier
                                  true, 1.0,   // check_vs2, vs2_multiplier
                                  false, 1.0,  // check_vs3, vs3_multiplier
                                  "%(mnemonic)s", ElemType);

    const uint32_t num_microops = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, sew);
    StaticInstPtr microop;
    for (int i = 0; i < num_microops; ++i) {
        microop = new %(class_name)sMicro<ElemType>(_machInst, i);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}
}};

// Specialized constructor for vector extension instructions (vsext_vf*, vzext_vf*)
// These instructions have different source register multiplier based on extension factor
def template VectorIntExtMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    // For extension instructions: source EMUL = destination LMUL / ext_div
    // So vs2_multiplier = 1.0 / ext_div
    // Note: Extension instructions (vsext_vf*, vzext_vf*) have no vs1 operand
    CHECK_AND_HANDLE_INVALID_REGS(%(class_name)s, _machInst, vflmul,
                                  true, 1.0,   // check_vd, vd_multiplier
                                  false, 1.0,  // check_vs1_for_vv, vs1_multiplier (no vs1 for ext instructions)
                                  true, 1.0 / %(ext_div)d,   // check_vs2, vs2_multiplier (EMUL = LMUL / ext_div)
                                  false, 1.0,  // check_vs3, vs3_multiplier
                                  "%(mnemonic)s", ElemType);

    const uint32_t num_microops = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, sew);
    StaticInstPtr microop;
    for (int i = 0; i < num_microops; ++i) {
        microop = new %(class_name)sMicro<ElemType>(_machInst, i);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}
}};

def template VectorIntMacroConstructorWithVMI {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    CHECK_AND_HANDLE_INVALID_REGS_WITH_VMI(%(class_name)s, _machInst, vflmul,
                                  true, 1.0,   // check_vd, vd_multiplier
                                  true, 1.0,   // check_vs1_for_vv, vs1_multiplier
                                  true, 1.0,   // check_vs2, vs2_multiplier
                                  false, 1.0,  // check_vs3, vs3_multiplier
                                  "%(mnemonic)s", ElemType);

    const uint32_t elem_num_per_vreg = VLEN / sew;
    const uint32_t vreg_banks = ((VLEN + DPLEN - 1) / DPLEN);
    const uint32_t elem_num_per_phy_reg = elem_num_per_vreg / vreg_banks;

    const uint32_t num_microops = calculateActiveBanksWithKnownVl(
        vflmul, _machInst, sew);

    bool is_vv_format = (std::string(mnemonic).find("_vv") != std::string::npos);
    bool is_vmv_vv = (std::string(mnemonic).find("_v_v") != std::string::npos);
    StaticInstPtr microop;
    VectorMicroInfo vmi;

    for (int i = 0; i < num_microops; ++i) {
        vmi.rs = i * elem_num_per_phy_reg;
        vmi.re = (i + 1) * elem_num_per_phy_reg;

        const uint32_t arch_vreg = i / vreg_banks;
        const uint32_t bank = i % vreg_banks;
        vmi.microVd = (_machInst.vd + arch_vreg) * VregBanks + bank;

        if (is_vv_format || is_vmv_vv) {
            vmi.microVs1 = (_machInst.vs1 + arch_vreg) * VregBanks + bank;
        } else {
            vmi.microVs1 = 0;
        }
        if (!is_vmv_vv) {
            vmi.microVs2 = (_machInst.vs2 + arch_vreg) * VregBanks + bank;
        } else {
            vmi.microVs2 = 0;
        }
        assert(vmi.microVd < NumVecStandardRegs);
        assert(vmi.microVs1 < NumVecStandardRegs);
        assert(vmi.microVs2 < NumVecStandardRegs);

        microop = new %(class_name)sMicro<ElemType>(_machInst, i, vmi);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}
}};

def template VectorIntMicroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    // vs1, vs2, vs3(old_vd), vm for *.vv, *.vx
    // vs2, (old_vd), vm for *.vi
    RegId srcRegIdxArr[24];
    RegId destRegIdxArr[1];
public:
    %(class_name)s(ExtMachInst _machInst, uint8_t _microIdx);
    Fault execute(ExecContext* xc, Trace::InstRecord* traceData)const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntMicroDeclareWithVMI {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    // vs1, vs2, vs3(old_vd), vm for *.vv, *.vx
    // vs2, (old_vd), vm for *.vi
    RegId srcRegIdxArr[8];
    RegId destRegIdxArr[1];
public:
    VectorMicroInfo vmi;
    %(class_name)s(ExtMachInst _machInst, uint8_t _microIdx, VectorMicroInfo& _vmi);
    Fault execute(ExecContext* xc, Trace::InstRecord* traceData)const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntMicroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint8_t _microIdx)
    : %(base_class)s("%(mnemonic)s", _machInst,
                     %(op_class)s, _microIdx)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;

    %(set_dest_reg_idx)s;
    %(set_src_reg_idx)s;
}

}};

def template VectorIntMicroConstructorWithVMI {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint8_t _microIdx,
                                          VectorMicroInfo& _vmi)
    : %(base_class)s("%(mnemonic)s", _machInst,
                     %(op_class)s, _microIdx)
{
    // 从参数接收vmi
    vmi = _vmi;

    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;

    %(set_dest_reg_idx)s;
    %(set_src_reg_idx)s;
}

}};

def template VectorIntMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }
    uint32_t elem_num_per_vreg = DPLEN / sew;

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();
    %(code)s;

    assert(vtypesrcIdx > 0);
    VTYPE rVtype = xc->getRegOperand(this, vtypesrcIdx);
    if (RVV_AGNOSTIC && rVtype.vta && rVl < vmi.re) {
        for (uint32_t ei = std::max(rVl, (uint64_t)vmi.rs); ei < vmi.re; ei++) {
            Vd[ei - vmi.rs] = ~0;
        }
    }

    %(op_wb)s;
    return NoFault;
}

}};

def template VectorIntVxsatMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }
    // Each micro-op works on one physical vector bank (DPLEN bits).
    uint32_t elem_num_per_vreg = DPLEN / sew;

    %(op_decl)s;
    %(op_rd)s;
    %(vm_decl_rd)s;
    COPY_OLD_VD();

    %(code)s;

    // Tail-agnostic handling in this micro-op's global element slice.
    assert(vtypesrcIdx > 0);
    VTYPE rVtype = xc->getRegOperand(this, vtypesrcIdx);
    const uint32_t global_rs = elem_num_per_vreg * this->microIdx;
    const uint32_t global_re = global_rs + elem_num_per_vreg;
    if (RVV_AGNOSTIC && rVtype.vta && rVl < global_re) {
        for (uint32_t ei = std::max<uint64_t>(rVl, global_rs);
             ei < global_re; ei++) {
            Vd[ei - global_rs] = ~0;
        }
    }

    %(op_wb)s;
    return NoFault;
}

}};

def template VectorIntExtMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s {
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    std::string generateDisassembly(Addr pc,
        const loader::SymbolTable *symtab) const override
    {
        std::stringstream ss;
        ss << mnemonic << ' ' << registerName(destRegIdx(0)) << ", "
            << registerName(srcRegIdx(0));
        if (machInst.vm == 0) ss << ", v0.t";
        return ss.str();
    }
};

}};

def template VectorIntExtMicroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    RegId srcRegIdxArr[8];
    RegId destRegIdxArr[1];
public:
    %(class_name)s(ExtMachInst _machInst, uint8_t _microIdx);
    Fault execute(ExecContext* xc, Trace::InstRecord* traceData)const override;
    std::string generateDisassembly(Addr pc,
        const loader::SymbolTable *symtab) const override
    {
        std::stringstream ss;
        ss << mnemonic << ' ' << registerName(destRegIdx(0)) << ", "
            << registerName(srcRegIdx(0));
        if (machInst.vm == 0) ss << ", v0.t";
        return ss.str();
    }
};

}};

def template VectorIntExtMicroExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  Trace::InstRecord* traceData) const
{
    using vu [[maybe_unused]] = std::make_unsigned_t<ElemType>;
    using vi [[maybe_unused]] = std::make_signed_t<ElemType>;

    if (machInst.vill) {
        return std::make_shared<IllegalInstFault>("VILL is set", machInst);
    }

    // Read vtype register for tail-agnostic processing
    assert(vtypesrcIdx > 0);
    VTYPE rVtype = xc->getRegOperand(this, vtypesrcIdx);

    auto offset = (DPLEN / sew) * (microIdx % %(ext_div)d);
    uint32_t elem_num_per_vreg = DPLEN / sew;
    switch (sew / %(ext_div)d) {
      case 8: {
        using vext  [[maybe_unused]] = int8_t;
        using vextu [[maybe_unused]] = uint8_t;
        %(op_decl)s;
        %(op_rd)s;
        %(vm_decl_rd)s;
        COPY_OLD_VD();
        %(code)s;
        // Tail-agnostic: set [vl, vlmax) elements to all 1s
        if (RVV_AGNOSTIC && rVtype.vta && rVl > 0) {
            uint32_t vlmax = VLEN / sew;
            vextu tail_val = ~0;
            for (uint32_t ei = rVl; ei < vlmax; ei++) {
                uint32_t byte_idx = ei * sizeof(ElemType);
                for (uint32_t b = 0; b < sizeof(ElemType); b++) {
                    Vd[byte_idx + b] = tail_val;
                }
            }
        }
        %(op_wb)s;
        break;
      }
      case 16: {
        using vext  [[maybe_unused]] = int16_t;
        using vextu [[maybe_unused]] = uint16_t;
        %(op_decl)s;
        %(op_rd)s;
        %(vm_decl_rd)s;
        COPY_OLD_VD();
        %(code)s;
        // Tail-agnostic: set [vl, vlmax) elements to all 1s
        if (RVV_AGNOSTIC && rVtype.vta && rVl > 0) {
            uint32_t vlmax = VLEN / sew;
            vextu tail_val = ~0;
            for (uint32_t ei = rVl; ei < vlmax; ei++) {
                uint32_t byte_idx = ei * sizeof(ElemType);
                for (uint32_t b = 0; b < sizeof(ElemType); b++) {
                    Vd[byte_idx + b] = tail_val;
                }
            }
        }
        %(op_wb)s;
        break;
      }
      case 32: {
        using vext  [[maybe_unused]] = int32_t;
        using vextu [[maybe_unused]] = uint32_t;
        %(op_decl)s;
        %(op_rd)s;
        %(vm_decl_rd)s;
        COPY_OLD_VD();
        %(code)s;
        // Tail-agnostic: set [vl, vlmax) elements to all 1s
        if (RVV_AGNOSTIC && rVtype.vta && rVl > 0) {
            uint32_t vlmax = VLEN / sew;
            vextu tail_val = ~0;
            for (uint32_t ei = rVl; ei < vlmax; ei++) {
                uint32_t byte_idx = ei * sizeof(ElemType);
                for (uint32_t b = 0; b < sizeof(ElemType); b++) {
                    Vd[byte_idx + b] = tail_val;
                }
            }
        }
        %(op_wb)s;
      break;
      }
      default: break;
    }

    return NoFault;
}

}};

def template VectorIntDecodeBlock {{
{
    const float vflmul = getVflmul(machInst.vtype8.vlmul);
    if (!check_vreg_group_valid(machInst.vd, vflmul, %(vd_multiplier)s) ||
        !check_vreg_group_valid(machInst.vs1, vflmul, %(vs1_multiplier)s) ||
        !check_vreg_group_valid(machInst.vs2, vflmul, %(vs2_multiplier)s)) {
        return new Unknown(machInst);
    }

    switch(machInst.vtype8.vsew) {
    case 0b000: return new %(class_name)s<uint8_t>(machInst);
    case 0b001: return new %(class_name)s<uint16_t>(machInst);
    case 0b010: return new %(class_name)s<uint32_t>(machInst);
    case 0b011: return new %(class_name)s<uint64_t>(machInst);
    default: GEM5_UNREACHABLE;
    }
}
}};

def template VectorIntWideningMacroDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s {
private:
    %(reg_idx_arr_decl)s;
public:
    %(class_name)s(ExtMachInst _machInst);
    using %(base_class)s::generateDisassembly;
};

}};

def template VectorIntWideningMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst)
    : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
{
    // Todo: move to Decode template
    // panic_if(vlmul == 3, "LMUL=8 is illegal for widening/narrowing inst");
    // when LMUL setted as m1, need to split to 2 micro insts

    CHECK_AND_HANDLE_INVALID_REGS(%(class_name)s, _machInst, vflmul,
                                  true, %(vd_multiplier)s,   // check_vd, vd_multiplier
                                  true, %(vs1_multiplier)s,  // check_vs1_for_vv, vs1_multiplier
                                  true, %(vs2_multiplier)s,  // check_vs2, vs2_multiplier
                                  false, 1.0,                // check_vs3, vs3_multiplier
                                  "%(mnemonic)s", ElemType);

    // Widening destination EMUL = LMUL * 2, destination EEW = 2 * SEW.
    const uint32_t num_microops = calculateActiveBanksWithKnownVl(
        2.0f * vflmul, _machInst, 2 * sew);

    StaticInstPtr microop;
    for (int i = 0; i < num_microops; ++i) {
        microop = new %(class_name)sMicro<ElemType>(_machInst, i);
        microop->setDelayedCommit();
        this->microops.push_back(microop);
    }

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

}};

