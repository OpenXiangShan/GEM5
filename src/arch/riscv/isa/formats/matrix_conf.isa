def template MatrixBasicDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[8];
        RegId destRegIdxArr[4];

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const override;
    };
}};

def template MatrixCSRCarrierDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[4];
        RegId destRegIdxArr[4];
        int carrierSrcIdx = -1;
        int carrierDstIdx = -1;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        using %(base_class)s::generateDisassembly;
    };
}};

def template MatrixBasicConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        %(extra_ctor)s;
    }
}};

def template MatrixBasicExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;
        %(post_exec)s;
        return NoFault;
    }
}};

def template MatrixCSRCarrierExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        Trace::InstRecord *traceData) const
    {
        if (!valid) {
            return std::make_shared<IllegalInstFault>(
                    csprintf("Illegal CSR index %#x\n", csr), machInst);
        }
        DPRINTF(RiscvMisc, "Executing inst: %s\n", disassemble(0));

        %(op_decl)s;
        %(op_rd)s;

        RegVal data, olddata;
        auto lowestAllowedMode = (PrivilegeMode)bits(csr, 9, 8);
        auto pm = (PrivilegeMode)xc->readMiscReg(MISCREG_PRV);
        if ((pm < lowestAllowedMode) && ((csr <CSR_HSTATUS
                ) ||(csr >CSR_HGATP)) && ((csr <CSR_VSSTATUS) || (
                    csr > CSR_VSATP))) {
            return std::make_shared<IllegalInstFault>(
                    csprintf("%s is not accessible in %s\n", csrName, pm),
                    machInst);
        }

        auto* isa = dynamic_cast<RiscvISA::ISA*>(xc->tcBase()->getIsaPtr());
        switch (csr) {
          case CSR_FFLAGS:
          case CSR_FRM:
          case CSR_FCSR: {
            STATUS status = xc->readMiscReg(MISCREG_STATUS);
            if (status.fs == FPUStatus::OFF) {
                return std::make_shared<IllegalInstFault>(
                        "FPU CSR access with FS off\n", machInst);
            }
            if (xc->readMiscReg(MISCREG_VIRMODE) == 1) {
                VSSTATUS vsstatus = xc->readMiscReg(MISCREG_VSSTATUS);
                if (vsstatus.fs == FPUStatus::OFF) {
                    return std::make_shared<IllegalInstFault>(
                            "FPU CSR access with VS FS off\n", machInst);
                }
            }
            break;
          }
          case CSR_VSTART:
          case CSR_VXSAT:
          case CSR_VXRM:
          case CSR_VCSR:
          case CSR_VL:
          case CSR_VTYPE:
          case CSR_VLENB: {
            STATUS status = xc->readMiscReg(MISCREG_STATUS);
            if (status.vs == 0) {
                return std::make_shared<IllegalInstFault>(
                        "Vector CSR access with VS off\n", machInst);
            }
            if (xc->readMiscReg(MISCREG_VIRMODE) == 1) {
                VSSTATUS vsstatus = xc->readMiscReg(MISCREG_VSSTATUS);
                if (vsstatus.vs == 0) {
                    return std::make_shared<IllegalInstFault>(
                            "Vector CSR access with VS VS off\n", machInst);
                }
            }
            break;
          }
          case CSR_SATP: {
            STATUS status = xc->readMiscReg(MISCREG_STATUS);
            HSTATUS hstatus = xc->readMiscReg(MISCREG_HSTATUS);
            int v = xc->readMiscReg(MISCREG_VIRMODE);
            if (v && pm == PRV_S && hstatus.vtvm == 1) {
                return std::make_shared<HVFault>();
            }
            if (!v && pm == PRV_S && status.tvm == 1) {
                return std::make_shared<IllegalInstFault>(
                        "SATP access with TVM enabled\n",
                        machInst);
            }
            break;
          }
          case CSR_TIME: {
            if (!isa->hpmCounterEnabled(MISCREG_TIME)) {
                return std::make_shared<HVFault>();
            }
            break;
          }
          default:
            break;
        }

        if (carrierSrcIdx >= 0) {
            olddata = xc->getRegOperand(this, carrierSrcIdx);
        } else if (csr == CSR_FCSR) {
            olddata = xc->readMiscReg(MISCREG_FFLAGS) |
                      (xc->readMiscReg(MISCREG_FRM) << FRM_OFFSET);
        } else {
            olddata = xc->readMiscReg(midx);
        }
        auto olddata_all = olddata;
        uint64_t maskVal_num = maskVal;
        if(csr == CSR_SIE){
            if(xc->readMiscReg(MISCREG_VIRMODE) == 1) {
                maskVal_num = (1ULL << 2)|(1ULL << 6)|(1ULL << 10);

            } else {
                maskVal_num = 0x222 & xc->readMiscReg(MISCREG_MIDELEG);
            }
        }

        olddata &= maskVal_num;
        DPRINTF(RiscvMisc, "Reading CSR %s: %#x\n", csrName, olddata);
        data = olddata;
        bool write = false;

        %(code)s;

        data &= maskVal_num;
        if(csr == CSR_HIE){
            xc->setMiscReg(midx, data);
        }
        if (data != olddata || csr == CSR_FCSR || (csr == CSR_FRM && write) || csr == CSR_VCSR) {
            if (bits(csr, 11, 10) == 0x3) {
                return std::make_shared<IllegalInstFault>(
                        csprintf("CSR %s is read-only\n", csrName), machInst);
            }
            auto newdata_all = data;
            newdata_all = (olddata_all & ~maskVal_num) | data;
            DPRINTF(RiscvMisc, "Writing %#x to CSR %s.\n",
                    newdata_all, csrName);
            switch (csr) {
              case CSR_FCSR:
                xc->setMiscReg(MISCREG_FFLAGS, bits(data, 4, 0));
                xc->setMiscReg(MISCREG_FRM, bits(data, 7, 5));
                break;
              case CSR_MIP: case CSR_MIE:
              case CSR_SIP: case CSR_SIE:
              case CSR_MSTATUS: case CSR_SSTATUS:
              case CSR_HSTATUS:
                if (newdata_all != olddata_all) {
                    xc->setMiscReg(midx, newdata_all);
                    auto new_val = xc->readMiscReg(MISCREG_STATUS);
                    DPRINTF(RiscvMisc, "After writing mstatus: %#lx.\n",
                            new_val);
                } else {
                    return std::make_shared<IllegalInstFault>(
                            "Only bits in mask are allowed to be set\n",
                            machInst);
                }
                break;
              default:
                xc->setMiscReg(midx, data);
                break;
            }
        }
        if (carrierDstIdx >= 0) {
            xc->setRegOperand(this, carrierDstIdx, data);
        }
        %(post_exec)s;
        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixBasicDisasm {{
    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        return mnemonic;
    }
}};

def format MatrixConfOp(code, *flags) {{
    iop = InstObjParams(
        name,
        Name,
        'RiscvStaticInst',
        {
            'code': code,
            'extra_ctor': "",
            'post_exec': ""
        },
        flags)
    header_output = MatrixBasicDeclare.subst(iop)
    decoder_output = MatrixBasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MatrixBasicExecute.subst(iop) + MatrixBasicDisasm.subst(iop)
}};

def format MatrixCarrierOp(code, extra_ctor, post_exec, *flags) {{
    iop = InstObjParams(
        name,
        Name,
        'RiscvStaticInst',
        {
            'code': code,
            'extra_ctor': extra_ctor,
            'post_exec': post_exec
        },
        flags)
    header_output = MatrixBasicDeclare.subst(iop)
    decoder_output = MatrixBasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MatrixBasicExecute.subst(iop) + MatrixBasicDisasm.subst(iop)
}};

let {{
def matrixCsrCarrierCtor(carrier_reg, write_guard):
    return '''
        setSrcRegIdx(_numSrcRegs++, %(carrier_reg)s);
        carrierSrcIdx = _numSrcRegs - 1;
        if (%(write_guard)s) {
            setDestRegIdx(_numDestRegs++, %(carrier_reg)s);
            _numTypedDestRegs[RMiscRegClass]++;
            carrierDstIdx = _numDestRegs - 1;
        }
    ''' % {
        'carrier_reg': carrier_reg,
        'write_guard': write_guard,
    }

def matrixCsrRs1Code(data_stmt):
    return '''
        Rd = data;
        %(data_stmt)s
        write = RS1 != 0;
    ''' % {
        'data_stmt': data_stmt,
    }

def matrixCsrUimmCode(data_stmt):
    return '''
        Rd = data;
        %(data_stmt)s
        write = uimm != 0;
    ''' % {
        'data_stmt': data_stmt,
    }

def matrixCarrierCsrOutputs(name, Name, code, carrier_reg,
        write_guard, post_exec, flags):
    iop = InstObjParams(
        name,
        Name,
        'CSROp',
        {
            'code': code,
            'extra_ctor': matrixCsrCarrierCtor(carrier_reg, write_guard),
            'post_exec': post_exec
        },
        flags)
    return (
        MatrixCSRCarrierDeclare.subst(iop),
        MatrixBasicConstructor.subst(iop),
        BasicDecode.subst(iop),
        MatrixCSRCarrierExecute.subst(iop)
    )

}};

def format MatrixCarrierRs1WriteCSROp(carrier_reg, post_exec, *flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        matrixCarrierCsrOutputs(
            name, Name, matrixCsrRs1Code('data = Rs1;'),
            carrier_reg, 'machInst.rs1 != 0', post_exec, flags)
}};

def format MatrixCarrierRs1SetCSROp(carrier_reg, post_exec, *flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        matrixCarrierCsrOutputs(
            name, Name, matrixCsrRs1Code('data |= Rs1;'),
            carrier_reg, 'machInst.rs1 != 0', post_exec, flags)
}};

def format MatrixCarrierRs1ClearCSROp(carrier_reg, post_exec, *flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        matrixCarrierCsrOutputs(
            name, Name, matrixCsrRs1Code('data &= ~Rs1;'),
            carrier_reg, 'machInst.rs1 != 0', post_exec, flags)
}};

def format MatrixCarrierUimmWriteCSROp(carrier_reg, post_exec, *flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        matrixCarrierCsrOutputs(
            name, Name, matrixCsrUimmCode('data = uimm;'),
            carrier_reg, 'machInst.csrimm != 0', post_exec, flags)
}};

def format MatrixCarrierUimmSetCSROp(carrier_reg, post_exec, *flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        matrixCarrierCsrOutputs(
            name, Name, matrixCsrUimmCode('data |= uimm;'),
            carrier_reg, 'machInst.csrimm != 0', post_exec, flags)
}};

def format MatrixCarrierUimmClearCSROp(carrier_reg, post_exec, *flags) {{
    (header_output, decoder_output, decode_block, exec_output) = \
        matrixCarrierCsrOutputs(
            name, Name, matrixCsrUimmCode('data &= ~uimm;'),
            carrier_reg, 'machInst.csrimm != 0', post_exec, flags)
}};
