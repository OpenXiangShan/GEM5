                    payload.frm = xmfrm;
                    payload.types1 = 0x1;
                    payload.types2 = 0x1;
                    payload.typed = 0x2;
                    payload.lhsElemType = matrix::MatrixElemType::Fp16;
                    payload.rhsElemType = matrix::MatrixElemType::Fp16;
