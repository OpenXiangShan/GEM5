                    payload.md = RD & 0x7;
                    payload.ms1 = RS1 & 0x7;
                    payload.ms2 = RS2 & 0x7;
                    payload.mtilem = mtilem;
                    payload.mtilen = mtilen;
                    payload.mtilek = mtilek;
