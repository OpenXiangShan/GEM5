            0x02: decode FUNCT3 {
                0x0: MatrixCarrierOp::mlae({{
                    // Preserve the scalar source slots consumed by MLS.
                    (void)Rs1_ud;
                    (void)Rs2_ud;
                    // Matrix state reads still follow the normal slot-based
                    // operand contract: src slot 2/3 carry Mtilem/Mtilek.
                    auto mtilem = xc->getRegOperand(this, 2);
                    auto mtilek = xc->getRegOperand(this, 3);
                    const auto md = RD & 0x7;
                    const auto width = (RD >> 3) & 0x3;
                    const bool isE8 =
                        width == RiscvISA::ISA::MatrixSewE8;
                    const bool isE16 =
                        width == RiscvISA::ISA::MatrixSewE16;
                    const auto maxK = isE8 ?
                        RiscvISA::ISA::MatrixTrLenE8Max :
                        RiscvISA::ISA::MatrixTrLenE16Max;
                    if (!RiscvISA::matrix_static_info::lsuEncodingLegal(
                            RiscvISA::matrixStaticInfoFromMachInst(machInst)) ||
                        mtilem == 0 || mtilek == 0 ||
                        mtilem > RiscvISA::ISA::MatrixRowNum ||
                        mtilek > maxK) {
                        return std::make_shared<IllegalInstFault>(
                            "mlae parameter check failed", machInst);
                    }
                }}, {{
                    setSrcRegIdx(_numSrcRegs++, MatrixRenamedTileMReg);
                    setSrcRegIdx(_numSrcRegs++, MatrixRenamedTileKReg);
                }}, {{
                }}, MatrixMemOp);
