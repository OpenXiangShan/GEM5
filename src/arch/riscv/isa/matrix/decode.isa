            0x04: decode FUNCT3 {
                0x0: MatrixCarrierOp::mfmacc_s_h({{
                    // src slot 0..2 carry Mtilem/Mtilen/Mtilek.
                    auto mtilem = xc->getRegOperand(this, 0);
                    auto mtilen = xc->getRegOperand(this, 1);
                    auto mtilek = xc->getRegOperand(this, 2);
                    auto xmxrm = xc->readMiscReg(MISCREG_XMXRM);
                    auto xmfrm = xc->readMiscReg(MISCREG_XMFRM);
                    auto xmsaten = xc->readMiscReg(MISCREG_XMSATEN);
                    if ((RD & 0x4) == 0 || (RS1 & 0x4) != 0 || (RS2 & 0x4) != 0 ||
                        mtilem > RiscvISA::ISA::MatrixRowNum ||
                        mtilen > RiscvISA::ISA::MatrixAccE32Max ||
                        mtilek > (RiscvISA::ISA::MatrixTrLenE8Max / 2)) {
