                                return std::make_shared<ReExec>();
                            }
                        } else {
                            auto *isa = static_cast<RiscvISA::ISA *>(
                                xc->tcBase()->getIsaPtr());
                            if (!isa->matrixTokenReady(RS2, Rs1_ud)) {
