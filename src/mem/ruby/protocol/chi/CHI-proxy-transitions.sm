// Send CompAck to HN
// Only needed on chain_tail

// ---------------------------------
// Load initiate request [x]
// ---------------------------------

// Mark load miss TBE as proxy TBE
// A push/read proxy might come here,
// Then It waits until the proxy entry is deallocated
// Might cause deadlock
// Need to prevent a ReadProxy/LoadProxy between "Load" and "LoadMissProxy"
// Currently we use reqInPort's recycle (zz_recycleReq)
transition(BUSY_BLKD, LoadMissProxy, BUSY_PROXY) {
  // TODO: Callback for load
  Initiate_Proxy;
  Initiate_ReadProxy;
  Register_ProxyLoad;
  ProcessNextState;
}

transition(BUSY_PROXY, AllocRequest) {
  Find_ProxyTBE;
}

// ---------------------------------
// Downstream Slave RX Transition [x]
// ---------------------------------
// After alloc TBE
transition({I, SC}, {ReadProxy}, BUSY_PROXY) {
  Initiate_Request;
  Initiate_ReadProxy;
  Initiate_Proxy;
  Allocate_DirEntry;
  Pop_ReqRdyQueue;
  ProcessNextState;
}

// no need tbe alloc
transition({BUSY_PROXY}, {ReadProxy}) {
  Mark_UpstreamRead; // If data is ready satisfy the request. If not, block until Compdata
  Try_ReplyProxyRead;
  Pop_ReqRdyQueue;
  ProcessNextState;
}

// Current block may not be evicted and a load is in progress
// TODO: Wait for the load to complete
// TODO: Add perf counter for this
transition(BUSY_BLKD, ReadProxy) {
  Proxy_Error;
}

transition({UC, UD, UD_T, SD, RSC, RSD, BUSY_INTR}, {ReadProxy}) {
  Proxy_Error;
}

transition(BUSY_PROXY, ReplyProxyData) {
  Reply_ProxyData;
  Pop_TriggerQueue;
  ProcessNextState;
}

// ---------------------------------
// Upstream Slave RX Handling [x]
// ---------------------------------
transition({I, SC}, {PushProxy}, BUSY_PROXY) {
  Initiate_Request;
  Initiate_Proxy;
  Allocate_DirEntry;
  Handle_PushProxy;
  Pop_ReqRdyQueue;
  ProcessNextState;
}

transition({UC, UD, UD_T, SD, RSC, RSD, BUSY_INTR}, {PushProxy}) {
  Proxy_Error;
}

transition(BUSY_BLKD, PushProxy) {
  Proxy_Error;
}

transition(BUSY_PROXY, PushProxy) {
  Handle_PushProxy;
  Pop_ReqInPort;
  ProcessNextState;
}

transition(BUSY_PROXY, SendCompDBID) {
  Send_CompDBID;
  Pop_TriggerQueue;
  ProcessNextState;
}

transition(BUSY_PROXY, CBWrData_SC) {
  Receive_ReqDataResp;
  // Receive_ProxyData; // Original action might work
  Initiate_Push;
  // Check_DataWaitingPush; // Same as below
  Try_SatisfyLoad;
  Pop_DataInQueue;
  // Write_Cache; // This is done in CheckCacheFill, after all events completed
  ProcessNextState;
}

/* When upstream sends ReadProxy, then recv PushProxy, it sends CompDBIDRespCancel
 * Downstream cancels without reply.
 * If a proxy transaction comples PushProxy is sent to upstream,
 * up sends proxy cancel if cache state is not I
 */
transition(BUSY_PROXY, CancelDownstreamPush) {
  Pop_TriggerQueue;
  Send_CompDBIDRespCancel;
  ProcessNextState;
}

// ---------------------------------
// Upstream Master [x]
// ---------------------------------

transition(BUSY_PROXY, SendReadProxy) {
  Send_ReadProxy;
  Pop_TriggerQueue;
  ProcessNextState;
}

transition(BUSY_PROXY, {CompData_SC}) {
  // Receive_ProxyData;
  Receive_ReqDataResp;
  UpdateDataState_FromReqDataResp;
  Try_SatisfyLoad; // "Callback_Miss" For proxy transitions
  // Currently we choose to push data only when we have it
  Initiate_Push;
  // Check_DataWaitingPush;
  Pop_DataInQueue;
  // Write_Cache;
  Check_ProxyEnd;
  // Profile_OutgoingEnd_DataResp;
  ProcessNextState;
}

transition(BUSY_PROXY, {CompData_I, CompData_UC, CompData_UD_PD, CompData_SD_PD}) {
  Proxy_Error;
}

// --------------------------------
// Downstream Master TX Transition [x]
// --------------------------------

// Triggers twice if 2 upstream
transition(BUSY_PROXY, SendPushReq) {
  Send_PushReq;
  Pop_TriggerQueue;
  ProcessNextState;
}

transition({BUSY_PROXY}, CompDBIDResp) {
  Try_PushData; // If failed, RXDAT sees dbid_ready, then triggers push
  Check_ProxyEnd;
  Pop_RespInQueue;
  ProcessNextState;
}

transition(BUSY_PROXY, SendPushData) {
  Push_ProxyData;
  Check_ProxyEnd;
  Pop_TriggerQueue;
  ProcessNextState;
}

transition(BUSY_PROXY, CompDBIDRespCancel) {
  Set_PushCancelled;
  Check_ProxyEnd;
  Pop_RespInQueue;
  ProcessNextState;
}

// We don't have 25 bit bus, so no need to use original TX_Data transition
// transition(BUSY_PROXY, TX_Data) {
//   Pop_TriggerQueue;
//   Send_Data;
//   Check_PushEnd;
//   processNextState_ClearPending;
// }

// -------------------------------
// Proxy TBE Final Transition
// -------------------------------

transition(BUSY_PROXY, Final, I) {
  Pop_TriggerQueue;
  Finalize_Proxy;
  Finalize_UpdateCacheFromTBE;
  Finalize_UpdateDirectoryFromTBE;
  Finalize_DeallocateRequest;
}

// -------------------------------
// Load Transition
// -------------------------------

transition(BUSY_PROXY, Load) {
  Pop_TriggerQueue;
  Register_ProxyLoad;
  Try_SatisfyLoad;
  ProcessNextState;
}

// ---------------------------------
// Tag/Data Array
// ---------------------------------

transition(BUSY_PROXY, CheckCacheFill, BUSY_PROXY) {
  CheckCacheFill; // This action includes processNextState
}

transition(BUSY_PROXY, DataArrayRead) {
  Pop_TriggerQueue;
  DataArrayRead;
  ProcessNextState_ClearPending;
}

transition(BUSY_PROXY, DataArrayWrite, BUSY_PROXY) {
  Pop_TriggerQueue;
  DataArrayWrite;
  ProcessNextState_ClearPending;
}

transition(BUSY_PROXY, TagArrayWrite) {TagArrayWrite} {
  Pop_TriggerQueue;
  TagArrayWrite;
  ProcessNextState_ClearPending;
}

transition(BUSY_PROXY, TagArrayRead) {TagArrayRead} {
  Pop_TriggerQueue;
  TagArrayRead;
  ProcessNextState_ClearPending;
}