action(Proxy_Error, desc="Error related to proxy transaction") {
    printTBEState("Proxy Error", tbe);
    error("Error condition encountered - printing state before exit");
}

action(Callback_Proxy, desc="Handle pending load causing a proxy") {
  if (tbe.dataValid && tbe.is_local_pf) {
    assert(use_prefetcher);
    pfProxy.completePrefetch(tbe.addr);

  } else if (tbe.dataValid && (tbe.reqType == CHIRequestType:Load)) {
    DPRINTF(RubySlicc, "Read data %s\n", tbe.dataBlk);
    sequencer.readCallback(tbe.addr, tbe.dataBlk, true);

  } else {
    error("Proxy transaction should only be Load");
  }

}

// If there is upstream, send push
action(Try_Push, desc="Push data to next neighbour") {

    // Get upstream id
    MachineID upstream = sharingManager.getUpstream(tbe.addr);
    if (upstream != MachineID::Null) {
        // Need push
        if (tbe.upstream_pending) {
            // If upstream already sent a readproxy, reply with data
            tbe.actions.push(Event:SendData)
        } else {
            // send Push to upstream
            tbe.push_sent = true;
        }
    }
}

action(Mark_UpstreamRead, desc="Receive upstream ReadProxy") {
    MachineID upstream = sharingManager.getUpstream(tbe.addr);
    assert(upstream = inport.machineid);
    if (hasData) {
        // When downstream already sent push, replay the upstream readproxy only
        tbe.actions.push(Event:SendData);
    } else {
        tbe.upstream_pending = true;
    }
    if (tbe.push_sent) {
        tbe.ignore_push = true;
    }
}

// Common actions for a proxy transaction
action(Initiate_Proxy, desc="Initialize TBE entry for proxy transaction") {
    // TODO

    tbe.actions.push(Event:CheckCacheFill);
    tbe.actions.push(Event:TagArrayWrite);
}

action(Initiate_Proxy_Upstream, desc="Proxy transaction initiated by upstream") {
    MachineID upstream = sharingManager.getUpstream(tbe.addr);
    assert(upstream = inport.machineid);
    assert(is_HN == false);
    int sharingGroup = sharingManager.getSharingDirection(tbe.addr);
    assert(sharingGroup != SharingDirection::None);
    tbe.actions.push(Event:SendReadProxy);
    tbe.actions.push(Event:CheckCacheFill);
    tbe.actions.push(Event:TagArrayWrite);
    //
    tbe.downstream = sharingManager.getDownstream(tbe.addr);
    tbe.chain_tail = tbe.downstream not RNF;
    tbe.upstream = sharingManager.getUpstream(tbe.addr);
    tbe.chain_head = tbe.upstream not this;
}

action(Init_Proxy_Downstream, desc="Proxy transaction initiated by downstream") {
    
    tbe.actions.push(Event:PushProxy);
    tbe.actions.push(Event:CheckCacheFill);
    tbe.actions.push(Event:TagArrayWrite);

    tbe.up_pending = true;
}

action(Discard_Push, desc="Discard push from downstream") {
    DPRINTF(RubySlicc, "Downstream sent a push but upstream already in proxy request\n");
}