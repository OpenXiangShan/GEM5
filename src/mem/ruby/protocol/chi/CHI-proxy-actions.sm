// ----------------------------------------
// Common actions for a proxy transaction
// ----------------------------------------
action(Initiate_Proxy, desc="Initialize TBE entry for proxy transaction") {
    assert(is_HN == false);
    tbe.is_proxy := true;
    tbe.upstream_0 := sharingManager.getUpstream_0(tbe.addr);
    tbe.upstream_1 := sharingManager.getUpstream_1(tbe.addr);
    tbe.downstream := sharingManager.getDownstream(tbe.addr);

    tbe.actions.push(Event:CheckCacheFill);
    tbe.actions.push(Event:TagArrayWrite);
}

action(Find_ProxyTBE, desc="Enqueue redRdy directly if proxy request meets BUSY_PROXY state") {
    peek(reqInPort, CHIRequestMsg) {
        enqueue(reqRdyOutPort, CHIRequestMsg, allocation_latency) {
            assert(in_msg.addr == address);
            assert(in_msg.is_local_pf == false);
            out_msg := in_msg;
        }
    }
  reqInPort.dequeue(clockEdge());
}

action(Pop_ReqInPort, desc="Remove req from raw RXREQ") {
    reqInPort.dequeue(clockEdge());
}

action(Register_LoadProxy, desc="Mark TBE for load callback") {
    tbe.load_pending := true;
}

action(Proxy_Error, desc="Error related to proxy transaction") {
    printTBEState("Proxy Error", tbe);
    error("Error condition encountered - printing state before exit");
}

action(Check_ProxyEnd, desc="Dealloc TBE if proxy transaction is complete") {
    bool proxy_end := proxyCompleted(tbe);
    if (proxy_end) {
        tbe.pendAction := Event:Final;
        Cycles trigger_latency := intToCycles(0);
        enqueue(triggerOutPort, TriggerMsg, trigger_latency) {
            out_msg.addr := tbe.addr;
            // TODO
        }
    }
}

action(Finalize_Proxy, desc="Finalize Proxy") {
    assert(tbe.is_proxy);
    assert(proxyCompleted(tbe));
}

