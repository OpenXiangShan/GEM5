# Preserve the H functional suite's undisturbed vector behavior.
# CONFIG_MULTICORE_DIFF is not set
# CONFIG_RVV_AGNOSTIC is not set
CONFIG_USE_MMAP=y
# CONFIG_ENABLE_MEM_DEDUP is not set
# The 260822 H checkpoint set needs a 16 GiB window; its gcpt restorer writes
# mstateen0 and guest stage-1 PTEs may carry PBMT.
CONFIG_RV_SMSTATEEN=y
CONFIG_RV_SVPBMT=y
CONFIG_MSIZE=0x400000000
# CBO and Sstc must land together with the matching GEM5 side.
CONFIG_RV_CBO=y
CONFIG_RV_SSTC=y
